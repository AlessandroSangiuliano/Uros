C=/usr/bin/cpp
M=$PWD/osfmk/build/src/lib/migcom/migcom

cppflags=
migflags=
files=

# If an argument to this shell script contains whitespace,
# then we will screw up.  migcom will see it as multiple arguments.
#
# As a special hack, if -i is specified first we don't pass -user to migcom.
# We do use the -user argument for the dependencies.
# In this case, the -user argument can have whitespace.

until [ $# -eq 0 ]
do
    case "$1" in
	-[dtqkKQvVtTrRsSlLxX] ) migflags="$migflags $1"; shift;;
	-i	) sawI=1; migflags="$migflags $1 $2"; shift; shift;;
	-user   ) user="$2"; if [ ! "${sawI-}" ]; then migflags="$migflags $1 $2"; fi; shift; shift;;
	-server ) server="$2"; migflags="$migflags $1 $2"; shift; shift;;
	-header ) header="$2"; migflags="$migflags $1 $2"; shift; shift;;
	-sheader ) sheader="$2"; migflags="$migflags $1 $2"; shift; shift;;
	-iheader ) iheader="$2"; migflags="$migflags $1 $2"; shift; shift;;
	-dheader ) dheader="$2"; migflags="$migflags $1 $2"; shift; shift;;
	-maxonstack ) migflags="$migflags $1 $2"; shift; shift;;
	# Which machine the stubs are for (#416).
	#
	# ⚠️ It has to be named HERE, above the `-*' catch-all, and that is the
	# whole of the bug this line fixes: everything this loop does not
	# recognise goes to the C PREPROCESSOR, so `-target x86_64' arrived at
	# cc -- which ignores it -- and migcom never saw it.  migcom's default
	# is i386, deliberately, so what came out was i386 message layout with
	# nothing said: 12-byte port descriptors where x86-64's are 16.
	#
	# It was the ONLY migcom option the catch-all swallowed.  Every other
	# one -- the single letters and -server, -sheader, -user, -header,
	# -iheader, -dheader, -maxonstack -- already has a case above; checked
	# against parseArgs() in src/lib/migcom/mig.c rather than assumed.
	-target ) migflags="$migflags $1 $2"; target="$2"; shift; shift;;
	-MD ) sawMD=1; cppflags="$cppflags $1"; shift;;
	-cpp) C=$2;shift; shift;;
#	-cc) C=$2; shift; shift;;
	-migcom) M=$2; shift; shift;;
	-* ) cppflags="$cppflags $1"; shift;;
	* ) files="$files $1"; shift;;
    esac
done

# How wide an address is on that machine, told to the PREPROCESSOR (#422).
#
# A .defs runs through cc -E with no -m32/-m64, so __i386__ and __x86_64__
# inside one describe the machine doing the build.  A type whose size follows
# the target's pointer width -- zone_info_t, vm_info_region_t, every structure
# with a vm_offset_t in it -- has to ask something else, and this is it.
#
# ⚠️ Derived from -target rather than accepted as an option of its own, and
# that is the point: a width passed separately is a second thing to keep in
# step with the first, and the two disagreeing is a wrong message layout with
# nothing said.  One answer, from the one flag that already names the machine.
#
# i386 when nothing was said, because that is migcom's own default and every
# invocation that predates -target means i386.  An unrecognised name stops
# here instead of guessing: a new machine has to say how wide it is, and
# finding out by generating the wrong stubs is not saying it.
case "${target-i386}" in
    i386 )	ptrbits=32;;
    x86_64 )	ptrbits=64;;
    * )		echo "mig: unknown -target '$target': say its pointer width here" >&2
		exit 1;;
esac
cppflags="$cppflags -DMIG_PTR_BITS=$ptrbits"

# Where the interface definitions live (#471).
#
# Every .defs in the tree opens with `import <mach/std_types.defs>', so every
# invocation needs this directory -- which used to mean every CMakeLists
# spelling it out, and there are a dozen of them with hand-rolled -I lists.
# Said here, in the one place all of them funnel through, no caller can omit
# it.  (The kernel does not use this script; its own list carries the same
# entry, and there are two because there are two pipelines, not two rules.)
#
# From the script's own location rather than $PWD: callers run it from
# several build directories, and a path relative to the caller would be a
# different directory each time.
uapi="$(CDPATH= cd -- "$(dirname -- "$0")/../uros/uapi" && pwd)" || {
	echo "mig: cannot find the uapi directory from $0" >&2
	exit 1
}
cppflags="$cppflags -I$uapi"

for file in $files
do
    base="`basename "$file" .defs`"
    temp="$base".$$
    rm -f "$temp".c "$temp".d
    (echo '#line 1 '\""$file"\"; cat "$file") > "$temp".c
    # 🔥 Two steps, not a pipe (#471).  `cmd | migcom || exit' tests the exit
    # status of MIGCOM, so a preprocessor that died on a missing include left
    # migcom parsing a truncated stream -- which it accepted -- and this
    # script returned success having written a stub with routines silently
    # missing from it.  The preprocessed text is named now, and cc's failure
    # is the one that stops us.
    $C -E $cppflags "$temp".c -o "$temp".i || { rm -f "$temp".c "$temp".i; exit 1; }
    $M $migflags "$temp".i || { rm -f "$temp".c "$temp".i; exit 1; }
    rm -f "$temp".i
    if [ "$sawMD" -a -f "$temp".d ]
    then
	deps=
	s=
	rheader="${header-${base}.h}"
	if [ "$rheader" != /dev/null ]; then
		deps="${deps}${s}${rheader}"; s=" "
	fi
	ruser="${user-${base}User.c}"
	if [ "$ruser" != /dev/null ]; then
		deps="${deps}${s}${ruser}"; s=" "
	fi
	rserver="${server-${base}Server.c}"
	if [ "$rserver" != /dev/null ]; then
		deps="${deps}${s}${rserver}"; s=" "
	fi
	rsheader="${sheader-/dev/null}"
	if [ "$rsheader" != /dev/null ]; then
		deps="${deps}${s}${rsheader}"; s=" "
	fi
	riheader="${iheader-/dev/null}"
	if [ "$riheader" != /dev/null ]; then
		deps="${deps}${s}${riheader}"; s=" "
	fi
	rdheader="${dheader-/dev/null}"
	if [ "$rdheader" != /dev/null ]; then
		deps="${deps}${s}${rdheader}"; s=" "
	fi
	for target in ${deps}
	do
		sed -e 's;^'"${temp}"'.o[ 	]*:;'"${target}"':;' \
		    -e 's;: '"${temp}"'.c;: '"$file"';' \
		< "${temp}".d > "${target}".d
	done
	rm -f "$temp".d
    fi
    rm -f "$temp".c
done

exit 0
