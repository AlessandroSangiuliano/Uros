#!/bin/sh
# 
# @OSF_COPYRIGHT@
#
# USAGE EXAMPLE:
#   sh scripts/mig \
#     -cpp "/usr/bin/cpp -Iosfmk/export/powermac/include -Iosfmk/src/mach_kernel" \
#     -migcom osfmk/build/src/lib/migcom/migcom \
#     -user your_file_user.c -header your_file.h \
#     -server your_file_server.c -sheader your_file_server.h \
#     your_file.defs
#
# All -I flags possono essere passati dentro -cpp tra virgolette.
# I parametri -user, -header, -server, -sheader permettono di specificare i nomi dei file di output.
#
# 
#
