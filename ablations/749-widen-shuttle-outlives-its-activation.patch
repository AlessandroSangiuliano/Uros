Kind: widen
Issue: #749
Holds open: a shuttle's last reference past act_free() -- the reaper takes a reference on the shuttle before the drops that free its activation and lets it go 50 ms later, the order a fired timer's reference in flight to thread_timeout() makes by chance; meanwhile the activation zone gives the freed activation to a new thread, and with the fix out thread_machine_destroy() then frees that live thread's floating-point area through the shuttle's top_act, and its next switch-in panics; each hold says so on the console, so that a fixed run that passes shows the window was open; at most 8 holds in a boot, because the reaper waits through each and 128 backed its queue up until act_test's arm 9 (#660) saw thousands of threads not yet freed
Run: --entry 14 600 -smp 4

diff --git a/uros/src/mach_kernel/kern/thread.c b/uros/src/mach_kernel/kern/thread.c
index e14d740a..dfbf48d4 100644
--- a/uros/src/mach_kernel/kern/thread.c
+++ b/uros/src/mach_kernel/kern/thread.c
@@ -1915,6 +1915,37 @@ Thread_info(
  *	The reaper thread will disappear in the next revision of thread
  *	control when it's function will be moved into thread_dispatch.
  */
+/*
+ * 749 widen: the reaper holds a reference on the shuttle across the drops
+ * that free its activation, and lets it go WIDEN_749_MS later, so that the
+ * shuttle's last reference goes after act_free() -- the order a fired timer's
+ * reference in flight to thread_timeout() makes by chance.  Meanwhile the
+ * activation zone may give the freed activation to a new thread.  At most
+ * WIDEN_749_HOLDS times in a boot, each said on the console: the reaper
+ * waits through each hold, and 128 of them backed its queue up so far that
+ * act_test's arm 9 (#660) saw thousands of threads not yet freed.
+ */
+#include <kern/time_out.h>
+#define	WIDEN_749_MS	50
+#define	WIDEN_749_HOLDS	8
+static int	widen749_holds = WIDEN_749_HOLDS;
+static int	widen749_said;
+
+static void
+widen749_let_go(thread_t thread, thread_act_t thr_act)
+{
+	if (widen749_said < 8) {
+		widen749_said++;
+		printf("#749 widen: the reaper held shuttle %p's last reference "
+		       "for %d ms after its activation %p was freed\n",
+		       thread, WIDEN_749_MS, thr_act);
+	}
+	assert_wait((event_t) &widen749_holds, FALSE);
+	thread_set_timeout(WIDEN_749_MS * hz / 1000);
+	thread_block((void (*)(void)) 0);
+	thread_deallocate(thread);
+}
+
 void
 reaper_thread(void)
 {
@@ -1923,6 +1954,7 @@ reaper_thread(void)
 		thread_act_t		thr_act;
 		struct ipc_port		*pool_port;
 		spl_t			s;
+		boolean_t		widen749_hold;
 
 		s = splsched();
 		simple_lock(&reaper_lock);
@@ -1939,6 +1971,13 @@ reaper_thread(void)
 			 */
 			(void) thread_wait(thread);
 
+			widen749_hold = FALSE;
+			if (widen749_holds > 0) {
+				widen749_holds--;
+				widen749_hold = TRUE;
+				thread_reference(thread);
+			}
+
 			thr_act = thread_lock_act(thread);
 			assert(thr_act && thr_act->thread == thread);
 
@@ -1989,6 +2028,9 @@ reaper_thread(void)
 			/* Remove the reference held by the thread: */
 			act_deallocate(thr_act);
 
+			if (widen749_hold)
+				widen749_let_go(thread, thr_act);
+
 			s = splsched();
 			simple_lock(&reaper_lock);
 		}
