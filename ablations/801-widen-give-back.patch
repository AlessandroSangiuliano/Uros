Kind: widen
Issue: #801
Holds open: the window between a stopped run's trap starting to give its lock back and the rmdir -- give_back() sleeps a second before it looks at the lock, so the second SIGTERM that systemctl stop sends, once the unit's main process has died on the first, always lands inside it rather than in 2 boots of 3; the fixed tree, which ignores the signals until the lock is back, must still give it back and pass

diff --git a/scripts/run-x86_64.sh b/scripts/run-x86_64.sh
index 906d804e..ec9a537b 100755
--- a/scripts/run-x86_64.sh
+++ b/scripts/run-x86_64.sh
@@ -1191,6 +1191,7 @@ give_back() {
 		esac
 	fi
 	QEMU_REAPED=1
+	sleep 1		# 801-widen-give-back: the window a second signal lands in
 	if [ -n "$LOCK_ID" ] && [ "$(lock_id)" = "$LOCK_ID" ]; then
 		rmdir "$LOCK" 2>/dev/null || true
 	elif [ -n "$LOCK_ID" ]; then
