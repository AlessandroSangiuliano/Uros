Kind: ablation
Issue: #598
Takes out: the refusal of an APIC id past eight bits -- the redirection entry's shift and the message's mask cut it again, to whichever processor has its low byte
Run: --entry 0 600 -smp 1
Expect: an apic id past eight bits refused by a redirection entry and a message address, not cut to its low byte: [0-4] of 5

diff --git a/uros/src/mach_kernel/x86_64/cpu/device_machdep.c b/uros/src/mach_kernel/x86_64/cpu/device_machdep.c
index 6c1674e6..f91012b8 100644
--- a/uros/src/mach_kernel/x86_64/cpu/device_machdep.c
+++ b/uros/src/mach_kernel/x86_64/cpu/device_machdep.c
@@ -573,9 +573,8 @@ device_md_debugger_break(void)
  */
 int msi_destination(uint32_t apic_id, unsigned long long *address)
 {
-	if (apic_id > 0xFFu)
-		return 0;
-	*address = MSI_ADDRESS_BASE | ((unsigned long long)apic_id << 12);
+	*address = MSI_ADDRESS_BASE | (((unsigned long long)apic_id & 0xFFu)
+				       << 12);
 	return 1;
 }
 
