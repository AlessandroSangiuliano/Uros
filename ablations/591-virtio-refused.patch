diff --git a/uros/src/mach_kernel/device/device_master.c b/uros/src/mach_kernel/device/device_master.c
index 6e55e1e5..d1ed34d1 100644
--- a/uros/src/mach_kernel/device/device_master.c
+++ b/uros/src/mach_kernel/device/device_master.c
@@ -782,6 +782,43 @@ check_cfg_access(natural_t bdf)
 
 /* ---- PCI configuration space ---- */
 
+/*
+ * #591's probe: the kernel refuses virtio-blk's own write of its command
+ * register, the ABLATE_591_NTH write of register ABLATE_591_REG of device
+ * ABLATE_591_BDF, as #577's ablation refused one configuration access -- see
+ * ablations/577-refuse-cfg.patch for the count of each step.  On x86-64's
+ * default board 0x20 is 00:04.0, virtio-blk, the boot disk's controller, and
+ * its command register is written 1 by pci_scan, which switches decoding off,
+ * 2 by pci_scan putting it back, and 3 by the driver switching I/O decoding
+ * and bus mastering on.  Refused there, the driver says it is not probing and
+ * the controller is lost with every region measured; the block server names
+ * ahci0a disk0a instead, and before #591 nothing asked for virtio_blk0a.
+ * Every counted access is printed with its ordinal, so the log shows which
+ * step the number landed on.  The count is not atomic: an experiment, never
+ * built otherwise.
+ */
+#define	ABLATE_591_BDF		0x20
+#define	ABLATE_591_REG		0x04
+#define	ABLATE_591_NTH		3
+
+static int
+ablate_591_refuse(natural_t bdf, int write, unsigned int reg)
+{
+	static unsigned int	ablate_591_seen;
+	unsigned int		n;
+
+	if (bdf != (natural_t)ABLATE_591_BDF || !write
+	    || reg != (unsigned int)ABLATE_591_REG)
+		return 0;
+	n = ++ablate_591_seen;
+	printf("device_pci_config: #591 probe — write %u of register 0x%02x "
+	       "on %02x:%02x.%u, by task %p%s\n", n, reg,
+	       (unsigned)(bdf >> 8), (unsigned)((bdf >> 3) & 0x1F),
+	       (unsigned)(bdf & 7), (void *)current_task(),
+	       n == ABLATE_591_NTH ? ": REFUSED" : "");
+	return n == ABLATE_591_NTH;
+}
+
 kern_return_t
 ds_master_device_pci_config_read(
 	ipc_port_t		master_port,
@@ -834,6 +871,9 @@ ds_master_device_pci_config_write(
 	kr = check_cfg_access((natural_t)((bus << 8) | (slot << 3) | func));
 	if (kr != KERN_SUCCESS)
 		return kr;
+	if (ablate_591_refuse((natural_t)((bus << 8) | (slot << 3) | func),
+			      1, reg))
+		return KERN_NO_ACCESS;
 
 	device_md_pci_write(bus, slot, func, reg, data);
 	return KERN_SUCCESS;
