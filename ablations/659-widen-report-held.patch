--- a/uros/src/mach_kernel/x86_64/boot/boot_c.c
+++ b/uros/src/mach_kernel/x86_64/boot/boot_c.c
@@ -10217,6 +10217,57 @@ static void descriptor_tables_init(void)
 /* ------------------------------------------------------------------ */
 /*  Entry from boot.S (SysV: %edi = multiboot magic, %esi = info ptr).  */
 /* ------------------------------------------------------------------ */
+/*
+ * Widen 659-widen-report-held: a report held by apic id 0x7777, which no
+ * processor has, let go by this processor's timer after 80 ticks at 10 Hz,
+ * eight seconds; one line printed meanwhile, and how long it took.
+ */
+void cons_report_plant(uint32_t who);
+void cons_report_let_go(void);
+
+static volatile unsigned held_ticks;
+
+static void held_tick(struct trap_frame *frame)
+{
+	(void)frame;
+	if (++held_ticks == 80)
+		cons_report_let_go();
+	lapic_eoi();
+}
+
+static void report_held_widen(void)
+{
+	trap_handler_t found = trap_get_handler(LAPIC_TIMER_VECTOR);
+	int had = interrupts_enabled();
+	uint64_t t0, t1;
+
+	trap_set_handler(LAPIC_TIMER_VECTOR, held_tick);
+	held_ticks = 0;
+	interrupts_enable();
+	if (!lapic_timer_start(10, LAPIC_TIMER_VECTOR)) {
+		kputs("UrMach x86-64: widen 659-widen-report-held: the timer refused 10 Hz, nothing held\r\n");
+	} else {
+		cons_report_plant(0x7777);
+		t0 = rdtsc();
+		kputs("UrMach x86-64: widen 659-widen-report-held: apic id 0x7777 holds a report and lets go in 8 s\r\n");
+		t1 = rdtsc();
+		kputs("UrMach x86-64: widen 659-widen-report-held: that line took ");
+		if (tsc_hz()) {
+			kputdec((t1 - t0) * 1000 / tsc_hz());
+			kputs(" ms\r\n");
+		} else {
+			kputdec(t1 - t0);
+			kputs(" cycles, no calibrated TSC\r\n");
+		}
+		while (held_ticks < 80)
+			cpu_pause();
+		lapic_timer_stop();
+	}
+	trap_set_handler(LAPIC_TIMER_VECTOR, found);
+	if (!had)
+		interrupts_disable();
+}
+
