@@ -120,7 +120,7 @@ blk_authed_handle(mach_port_t device)
 	 * its deadline: a handle opened on a capability asked for 300 ms reads
 	 * up to its revocation, milliseconds after the 300 ms (cap_test [54]).
 	 */
