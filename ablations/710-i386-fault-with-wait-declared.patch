-					trunc_page((vm_offset_t)subcode),
-					VM_PROT_READ|VM_PROT_WRITE, FALSE);
+		  	result = vm_fault(map,
+					  trunc_page((vm_offset_t)subcode),
+					  VM_PROT_READ|VM_PROT_WRITE,
+					  FALSE);
 		}
