+++ a/uros/src/mach_kernel/kern/thread.c
@@ -1314,24 +1314,6 @@ thread_create_in(thread_act_t thr_act, void (*start_pos)(void),
 		return(KERN_FAILURE);
 	}
 
-	/*
-	 * 🔴 CHAIN IT ONTO THE TASK NOW, WHOLE (#935).  act_create() used to
-	 * do this, before the thread existed; a task_info(TASK_THREAD_TIMES_
-	 * INFO) that walked thr_acts in that window asserted on an activation
-	 * with no thread yet.  Here the thread is attached and the task is
-	 * still active (checked just above, under this same task lock), so
-	 * every activation reachable through the list has a thread -- the
-	 * property those walks assume for activations with no pool_port.
-	 */
-	mutex_lock(&parent_task->act_list_lock);
-	thr_act->thr_acts.next = parent_task->thr_acts.next;
-	thr_act->thr_acts.prev = &parent_task->thr_acts;
-	parent_task->thr_acts.next->prev = &thr_act->thr_acts;
-	parent_task->thr_acts.next = &thr_act->thr_acts;
-	parent_task->thr_act_count++;
-	parent_task->res_act_count++;
-	mutex_unlock(&parent_task->act_list_lock);
-
 	task_unlock(parent_task);
 	pset_unlock(pset);
 
diff --git b/uros/src/mach_kernel/kern/thread_act.c a/uros/src/mach_kernel/kern/thread_act.c
index 8bb61605..ee1a7746 100644
--- b/uros/src/mach_kernel/kern/thread_act.c
+++ a/uros/src/mach_kernel/kern/thread_act.c
@@ -1147,19 +1147,20 @@ act_create(task_t task, vm_offset_t user_stack, vm_size_t stack_size,
 		}
 	}
 
-	/*
-	 * 🔴 NOT ON THE TASK'S LIST YET (#935).  The chaining moved to
-	 * thread_create_in(), which does it under the task lock once the
-	 * thread is attached and the task is still active -- so an activation
-	 * is discoverable through task->thr_acts only when it is whole.
-	 * Before, act_create() listed it here, with no thread; task_info(
-	 * TASK_THREAD_TIMES_INFO) and task_assign() walk that list and assert
-	 * a thread on every activation without a pool_port, and one caught a
-	 * half-built activation between here and the attach.  thr_acts.next is
-	 * NULL (bzero above), which act_disable_task_locked() reads as "not
-	 * listed", so an activation freed before it is listed unwinds
-	 * cleanly.
-	 */
+	task_lock(task);
+
+	/* Chain the thr_act onto the task's list */
+	mutex_lock(&task->act_list_lock);
+	thr_act->thr_acts.next = task->thr_acts.next;
+	thr_act->thr_acts.prev = &task->thr_acts;
+	task->thr_acts.next->prev = &thr_act->thr_acts;
+	task->thr_acts.next = &thr_act->thr_acts;
+	task->thr_act_count++;
+	/* no need to check for transition from 0 -> 1 here */
+	task->res_act_count++;
+	mutex_unlock(&task->act_list_lock);
+
+	task_unlock(task);
 
 	/* Cache the task's map and take a reference to it */
