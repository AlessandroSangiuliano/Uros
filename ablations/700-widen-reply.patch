--- a/uros/src/mach_kernel/ipc/ipc_mqueue.c
+++ b/uros/src/mach_kernel/ipc/ipc_mqueue.c
@@ -192,6 +192,7 @@
 #include <kern/ipc_sched.h>
 #include <kern/ipc_kobject.h>
 #include <kern/misc_protos.h>
+#include <kern/thread_act.h>	/* #700's widen: top_act->active */
 #include <ipc/ipc_mqueue.h>
 #include <ipc/ipc_thread.h>
 #include <ipc/ipc_kmsg.h>
@@ -734,6 +735,32 @@ int	ipc_dts_smp __attribute__((section(".data"))) = 0;
  */
 unsigned int	ipc_dts_declined_swapped;
 
+/*
+ * #700's widened window, and not an ablation.  A receiver whose activation
+ * thread_terminate() has disabled comes back for its message
+ * WIDEN_700_RECEIVER_US late, so that a reply sent after the termination finds
+ * it still queued; the reply's deliverer then spins WIDEN_700_DELIVERER_US
+ * between taking it off the queue and waking it.  With the fix in, that spin
+ * runs under imq_lock, where the receiver waits for it; with the fix out, it
+ * runs after imq_unlock(), and the receiver takes the message, halts in
+ * thread_terminate_self() and is woken out of the reaper's queue.  Only for an
+ * activation being terminated, so that the rest of the boot runs at its own
+ * speed.
+ */
+#define	WIDEN_700_RECEIVER_US	20000
+#define	WIDEN_700_DELIVERER_US	100000
+
+static void
+widen_700(thread_t th, int us, const char *what)
+{
+	if (th->top_act != THR_ACT_NULL && !th->top_act->active) {
+		/* said, so that a fixed arm that passes shows the window opened */
+		printf("#700 widen: %s %d us, thread %p being terminated\n",
+		       what, us, th);
+		delay(us);
+	}
+}
+
 mach_msg_return_t
 ipc_mqueue_deliver(
 	register ipc_port_t	port,
@@ -945,6 +972,8 @@ ipc_mqueue_deliver(
 		if (!direct)
 			splx(s);
 	}
+	widen_700(receiver, WIDEN_700_DELIVERER_US,
+	    "a reply holds its receiver off the queue, not yet woken, for");
 	if (!direct)
 		thread_go(receiver);
 	imq_unlock(mqueue);
@@ -1185,6 +1214,8 @@ ipc_mqueue_receive(
 		thread_block(continuation);
 		if (option & MACH_RCV_TIMEOUT)
 			reset_timeout_check(&self->timer);
+		widen_700(self, WIDEN_700_RECEIVER_US,
+		    "a receiver comes back for its message late by");
 
                 /* Save proper wait_result in case we block */
 		save_wait_result = self->wait_result;
