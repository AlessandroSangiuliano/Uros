+/*
+ * 889-widen-a48-round-robin: every thread of the arm at POLICY_RR, one
+ * priority, so that where a thread goes back on the run queue decides who runs
+ * next, and nothing else does.
+ */
+static mach_port_t		a48_pset = MACH_PORT_NULL;
+static int			a48_pri = -1;
+static volatile unsigned	a48_rr_set, a48_rr_refused;
+
+/*
+ * A quantum of 0 is refused (#787's invalid_rr_quantum), and the first version
+ * of this widen asked for it and threw the answer away: in force nowhere, its
+ * A/B tested timesharing.  So each answer is counted, and the first refusal
+ * said.
+ */
+static void
+a48_rr(thread_act_t t)
+{
+	policy_rr_base_data_t	rr;
+	policy_rr_limit_data_t	limit;
+	kern_return_t		kr;
+
+	if (a48_pset == MACH_PORT_NULL || a48_pri < 0)
+		return;
+	rr.quantum = 50;
+	rr.base_priority = a48_pri;
+	limit.max_priority = a48_pri;
+	kr = thread_set_policy(t, a48_pset, POLICY_RR, (integer_t *) &rr,
+			       POLICY_RR_BASE_COUNT, (integer_t *) &limit,
+			       POLICY_RR_LIMIT_COUNT);
+	if (kr == KERN_SUCCESS)
+		a48_rr_set++;
+	else if (a48_rr_refused++ == 0)
+		printf("act_test: [48] 889-widen-a48-round-robin: "
+		       "thread_set_policy answered 0x%x — the widen is not in "
+		       "force\n", kr);
+}
