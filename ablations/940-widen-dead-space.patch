Kind: widen
Issue: #940
Over: 940-probe-given-back.patch
Holds open: act_test [57]'s question, msgh_id 5757, in mach_msg()'s hot path before its resolve, until its space has died and the port its destination named is back in its zone.  It notes that port, then sleeps a tick at a time while the thread is still its task's, where thread_stop_wait() finds it stopped; task_terminate() takes the thread off the task and aborts the sleep, and waits for it no more, and the thread waits on, up to a second in all, until the space is dead, then until the port carries 940-probe-given-back's mark, up to 300 ms.  After the resolve the zone hands out its free ports, each given back at once, until it hands out that one, up to 512, for the probe to ask whether the resolve took its lock.  The port zone runs without its per-CPU magazines (#330), so that the free ports come from one list.  A single tick asleep, as 688-widen-copyin-late sleeps for [14], was caught 0 times in 4: thread_terminate()'s act_abort() woke the thread at once, before the space was destroyed, and a diagnostic boot found it awake with the space alive in 20 rounds of 20.  With the fix the resolve refuses the dead space before it touches a port; the fixed tree must pass
Run: --entry 14 600 -smp 4
diff --git a/uros/src/mach_kernel/ipc/mach_msg.c b/uros/src/mach_kernel/ipc/mach_msg.c
index 581bd595..ce07eb64 100644
--- a/uros/src/mach_kernel/ipc/mach_msg.c
+++ b/uros/src/mach_kernel/ipc/mach_msg.c
@@ -1597,6 +1597,7 @@ urmach_msg_overwrite_trap_call(
 		    {
 			register mach_port_t reply_name =
 				hdr->msgh_local_port;
+			ipc_port_t w940d_port = IP_NULL; /* 940-widen-dead-space */
 
 			if (reply_name != rcv_name) {
 				HOT(c_mmot_g_slow_copyin3++);
@@ -1608,6 +1609,46 @@ urmach_msg_overwrite_trap_call(
 			index = MACH_PORT_INDEX(reply_name);
 			gen = MACH_PORT_GEN(reply_name);
 
+			if (hdr->msgh_id == 5757) {	/* 940-widen-dead-space */
+				extern void	delay(int);
+				ipc_entry_t	w940_e;
+				int		w;
+
+				/* act_test [57]'s question: the port its
+				 * destination names now */
+				is_read_lock(space);
+				w940_e = space->is_active ?
+				    ipc_entry_lookup(space,
+						     hdr->msgh_remote_port) :
+				    IE_NULL;
+				if (w940_e != IE_NULL &&
+				    (w940_e->ie_bits & MACH_PORT_TYPE_SEND))
+					w940d_port = (ipc_port_t)
+						w940_e->ie_object;
+				is_read_unlock(space);
+				/* asleep a tick at a time while the thread is
+				 * still its task's, where thread_stop_wait()
+				 * finds it stopped; task_terminate() then
+				 * takes it off the task and aborts the sleep,
+				 * and waits for it no more, and the thread
+				 * waits on until the space is dead */
+				for (w = 0; w < 100 && space->is_active; w++) {
+					if (current_act()->active)
+						mutex_pause();
+					else
+						delay(100);
+				}
+				/* then until the port's memory is back in its
+				 * zone, as 940-probe-given-back marks it */
+				if (space->is_active)
+					w940d_port = IP_NULL;
+				for (w = 0; w940d_port != IP_NULL &&
+					    w < 300000 &&
+					    (vm_offset_t) w940d_port->ip_rcu.func !=
+					    (vm_offset_t) 0xf4eef4eef4eef4eeUL; w++)
+					delay(1);
+			}
+
 			/*
 			 * #331 step 2 part 3b: try resolving both names WITHOUT
 			 * the space lock.  On success both ports are locked and
@@ -1627,6 +1668,26 @@ urmach_msg_overwrite_trap_call(
 			}
 		    }
 
+			if (w940d_port != IP_NULL) {	/* 940-widen-dead-space */
+				ipc_port_t	w;
+				int		i;
+
+				/* the zone hands out its free ports, each
+				 * given back at once, until it hands out this
+				 * one, for 940-probe-given-back to ask whether
+				 * the resolve took its lock */
+				for (i = 0; i < 512; i++) {
+					w = ipc_port_alloc_special(
+						ipc_space_kernel);
+					if (w == IP_NULL)
+						break;
+					ipc_port_dealloc_special(w,
+							ipc_space_kernel);
+					if (w == w940d_port)
+						break;
+				}
+			}
+
 			is_read_lock(space);
 
 			size = space->is_table_size;
