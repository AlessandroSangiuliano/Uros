Kind: ablation
Issue: #923
Takes out: the handlers -- SYS_clock_gettime and SYS_gettimeofday leave libposix-uros's table, so musl's clock_gettime() answers ENOSYS again and leaves its timespec as it was: musl_test's [25] must say WRONG
Run: --entry 14 600 -smp 4
Expect: musl_test: \[25\] WRONG

diff --git a/uros/src/lib/libposix-uros/handlers.c b/uros/src/lib/libposix-uros/handlers.c
index 4779d169..10ee9bf0 100644
--- a/uros/src/lib/libposix-uros/handlers.c
+++ b/uros/src/lib/libposix-uros/handlers.c
@@ -177,21 +177,6 @@ static long h_nanosleep(long req, long rem, long a3,
     return __uros_nanosleep((const void *)req, (void *)rem);
 }
 
-/* #923: the two clocks musl asks for, served in posix_time.c. */
-static long h_clock_gettime(long clk, long ts, long a3,
-                            long a4, long a5, long a6)
-{
-    (void)a3; (void)a4; (void)a5; (void)a6;
-    return __uros_clock_gettime(clk, (void *)ts);
-}
-
-static long h_gettimeofday(long tv, long tz, long a3,
-                           long a4, long a5, long a6)
-{
-    (void)a3; (void)a4; (void)a5; (void)a6;
-    return __uros_gettimeofday((void *)tv, (void *)tz);
-}
-
 static long h_open(long path, long flags, long mode,
                    long a4, long a5, long a6)
 {
@@ -885,8 +870,7 @@ static const struct entry table[] = {
     { SYS_munmap,           h_munmap          },
     { SYS_mprotect,         h_mprotect        },
     { SYS_nanosleep,        h_nanosleep       },
-    { SYS_clock_gettime,    h_clock_gettime   },	/* #923 */
-    { SYS_gettimeofday,     h_gettimeofday    },	/* #923 */
+    /* 923-no-clock-handler: the two clocks unserved again */
     { SYS_readv,            h_readv           },
     { SYS_writev,           h_writev          },
     { SYS_rt_sigaction,     h_rt_sigaction    },
