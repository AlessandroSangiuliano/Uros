diff --git a/uros/src/mach_kernel/x86_64/trap/swap_disable_test.c b/uros/src/mach_kernel/x86_64/trap/swap_disable_test.c
index bccf6559..696376f4 100644
--- a/uros/src/mach_kernel/x86_64/trap/swap_disable_test.c
+++ b/uros/src/mach_kernel/x86_64/trap/swap_disable_test.c
@@ -49,7 +49,9 @@
 #include <kern/thread_swap.h>
 #include <kern/time_out.h>		/* hz */
 
+#include <cpu/regs.h>			/* cpu_pause() */
 #include <cpu/spl.h>
+#include <time/tsc.h>			/* the widened windows' clock */
 #include <trap/handoff_test.h>		/* swap_state_name() */
 #include <trap/swap_disable_test.h>
 
@@ -104,10 +106,26 @@ sd_park(void)
  * Where ablations/642-widen-swap.patch tells the swapper which activation to
  * hold open.  Nothing, without it.
  */
+extern thread_act_t	swap_widen_act;
+
 static void
 sd_window(thread_act_t act)
 {
-	(void) act;
+	swap_widen_act = act;
+}
+
+/* 100 ms, preemptible: ten ticks and more for a thread that looks once a tick. */
+void
+swap_widen_spin(void)
+{
+	uint64_t	span, t0;
+
+	if (tsc_hz() == 0)
+		return;
+	span = tsc_hz() / 10;
+	t0 = rdtsc();
+	while (rdtsc() - t0 < span)
+		cpu_pause();
 }
 
 static int
