+/*
+ * 749 probe: a thread whose context has lost its floating-point area, the way
+ * thread_machine_destroy() leaves one, put on a run queue.  The next processor
+ * to choose it must name it before switching to it.
+ */
+static void
+probe749_body(void)
+{
+	for (;;)
+		thread_block((void (*)(void)) 0);
+}
+
+static void
+probe749_switch_to_destroyed(void)
+{
+	thread_t	th;
+	thread_act_t	act;
+	spl_t		s;
+
+	if (thread_create_at(kernel_task, &th, probe749_body) != KERN_SUCCESS)
+		panic("749 probe: the thread was not made");
+	thread_swappable(th->top_act, FALSE);
+	s = splsched();
+	thread_lock(th);
+	act = th->top_act;
+	printf("749 probe: thread %p, activation %p: its floating-point area "
+	       "taken away, and the thread put on a run queue\n", th, act);
+	act->mact.pcb->ctx.fpu_area = 0;
+	th->state |= TH_RUN;
+	thread_setrun(th, TRUE, TAIL_Q);
+	thread_unlock(th);
+	splx(s);
+	act_deallocate(act);
+	thread_resume(act);
+}
+
