Kind: widen
Issue: #777
Holds open: the woken threads of act_test's arms 39 and 40 for 20 ms or so, running, before their first receive and before they count a wakeup -- what a virtual processor that is slow to wake looks like to these arms, on any host: a spin, because a thread asleep in a wait would read as one that has come to wait.  The arms' waits sleep and sit it out
Run: --entry 14 300 -smp 4

diff --git a/uros/src/tests/act_test/act_test.c b/uros/src/tests/act_test/act_test.c
--- a/uros/src/tests/act_test/act_test.c
+++ b/uros/src/tests/act_test/act_test.c
@@ -5915,6 +5915,16 @@
 	return 0;
 }
 
+/* 777-widen-slow-thread: about 20 ms at 3 GHz, running */
+static void
+arm_slow_thread(void)
+{
+	unsigned long long	t = __builtin_ia32_rdtsc();
+
+	while (__builtin_ia32_rdtsc() - t < 60000000ULL)
+		;
+}
+
 /* -N, as the kernel says it.  arm 39 and arm 40. */
 static int
 arm_direct_switch(mach_port_t host)
@@ -5959,12 +5969,14 @@
 
 	(void) arg;
 	arm_thirty_nine_thread = mach_thread_self();
+	arm_slow_thread();
 	for (;;) {
 		if (mach_msg(&m.h, MACH_RCV_MSG, 0, sizeof m,
 			     arm_thirty_nine_port, MACH_MSG_TIMEOUT_NONE,
 			     MACH_PORT_NULL) != MACH_MSG_SUCCESS ||
 		    m.h.msgh_id != A39_WAKE)
 			return NULL;
+		arm_slow_thread();
 		arm_thirty_nine_got++;
 	}
 }
@@ -6312,11 +6324,13 @@
 
 	(void) arg;
 	arm_forty_thread = mach_thread_self();
+	arm_slow_thread();
 	for (;;) {
 		if (mach_msg(&m.h, MACH_RCV_MSG, 0, sizeof m, arm_forty_port,
 			     MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL)
 		    != MACH_MSG_SUCCESS || m.h.msgh_id != A40_WAKE)
 			return NULL;
+		arm_slow_thread();
 		arm_forty_got++;
 	}
 }
