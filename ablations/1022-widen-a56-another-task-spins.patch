+/*
+ * The widen (#1022): two threads of another task spin beside the rounds at
+ * one processor, as a test's forked processes did in the merge test of 28/11.
+ * A thread of this task ends that task once the rounds are over, or after
+ * 60 s if a WRONG ended them first.
+ */
+#define	A56_HOG_THREADS	2
+#define	A56_HOG_STACK	16384
+
+static volatile int	a56_hog_done;
+static mach_port_t	a56_hog_task = MACH_PORT_NULL;
+
+static void
+a56_hog_spin(void)
+{
+	for (;;)
+		__asm__ __volatile__("pause");
+}
+
+static int
+a56_hog_start(void)
+{
+	struct x86_64_thread_state	state;
+	mach_msg_type_number_t		count;
+	vm_address_t			stack;
+	mach_port_t			t;
+	int				i, started = 0;
+
+	if (task_create(mach_task_self(), NULL, 0, TRUE, &a56_hog_task) !=
+	    KERN_SUCCESS)
+		return 0;
+	for (i = 0; i < A56_HOG_THREADS; i++) {
+		stack = 0;
+		count = x86_64_THREAD_STATE_COUNT;
+		if (vm_allocate(a56_hog_task, &stack, A56_HOG_STACK, TRUE) !=
+		    KERN_SUCCESS || thread_create(a56_hog_task, &t) !=
+		    KERN_SUCCESS)
+			break;
+		if (thread_get_state(t, x86_64_THREAD_STATE,
+				     (thread_state_t) &state, &count) ==
+		    KERN_SUCCESS) {
+			state.rip = (uint64_t) (uintptr_t) a56_hog_spin;
+			state.rsp = (uint64_t) (stack + A56_HOG_STACK - 8);
+			if (thread_set_state(t, x86_64_THREAD_STATE,
+					     (thread_state_t) &state, count) ==
+			    KERN_SUCCESS && thread_resume(t) == KERN_SUCCESS)
+				started++;
+		}
+		(void) mach_port_deallocate(mach_task_self(), t);
+	}
+	printf("act_test: [56] the widen: %d threads of another task spin "
+	       "beside the rounds (#1022)\n", started);
+	return 1;
+}
+
+static void *
+a56_hog_keeper(void *arg)
+{
+	int	waited;
+
+	(void) arg;
+	for (waited = 0; !a56_hog_done && waited < 60000; waited += 100)
+		(void) nap(100);
+	(void) task_terminate(a56_hog_task);
+	(void) mach_port_deallocate(mach_task_self(), a56_hog_task);
+	return NULL;
+}
