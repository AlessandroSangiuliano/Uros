+
+/* 940-widen-dead-name: whether `name' is a send right to a port that has
+ * died, read under the space's read lock */
+static boolean_t
+w940_dest_died(
+	ipc_space_t	space,
+	mach_port_t	name)
+{
+	ipc_entry_t	e;
+	boolean_t	died = FALSE;
+
+	is_read_lock(space);
+	e = space->is_active ? ipc_entry_lookup(space, name) : IE_NULL;
+	if (e != IE_NULL && (e->ie_bits & MACH_PORT_TYPE_SEND) &&
+	    !ip_active((ipc_port_t) e->ie_object))
+		died = TRUE;
+	is_read_unlock(space);
+	return died;
+}
