@@ -1608,6 +1628,36 @@ urmach_msg_overwrite_trap_call(
 			index = MACH_PORT_INDEX(reply_name);
 			gen = MACH_PORT_GEN(reply_name);
 
+			if (hdr->msgh_id == 2098 ||	/* 940-widen-dead-name */
+			    hdr->msgh_id == 2061) {
+				extern void delay(int);
+				extern volatile int w940_open, w940_armed;
+				int w;
+
+				/* task_info()'s message, and thread_create()'s,
+				 * which act_test [54]'s creator sends once its
+				 * trap refuses, wait for a window: up to 100 us
+				 * for one to be held, then until it opens,
+				 * holding no reference.  To a destination that
+				 * has died, up to 5 ms more, asked again after
+				 * the 100 us too, since a messenger's request is
+				 * as likely as not waiting when the child dies:
+				 * no request then turns the dead name in before
+				 * the odd rounds' destroy holds its window, on
+				 * a slow machine too, and in the even rounds the
+				 * first to give up converts while the others
+				 * still wait */
+				for (w = 0; w < 100 && !w940_armed; w++)
+					delay(1);
+				if (!w940_armed &&
+				    w940_dest_died(space, hdr->msgh_remote_port))
+					for (w = 0; w < 5000 && !w940_armed; w++)
+						delay(1);
+				for (w = 0; w < 300000 && w940_armed &&
+					    !w940_open; w++)
+					delay(1);
+			}
+
