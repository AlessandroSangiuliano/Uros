Kind: widen
Issue: #940
Over: 940-probe-given-back.patch
Holds open: the release of a dead port's last reference, in ipc_right_check() and in ipc_right_destroy()'s dead branch, until the port's memory is back in its zone, then 200 us more with w940_open said; then the zone hands the port out again, for 940-probe-given-back to ask whether its lock was taken meanwhile.  Before the release, where the port is not locked, it waits up to 500 us for the requests still in flight to give their references back, so that this release is the port's last, and allocates a port and gives it back, so that one lies ahead of this port on the zone's list; and the port zone runs without its per-CPU magazines (#330), so that a port given back goes on that list, where the zone's 64-bit free pointer makes it read as active on x86-64, and is the next one handed out.  task_info()'s message, 2098, which act_test [54]'s messengers send with no trap first, waits in mach_msg's hot path up to 100 us for a window to be held, then until it opens, before it resolves its names, holding no reference.  With the fix the entry is cleared before the release, and a resolve in the window finds a dead name or no name; the fixed tree must pass
Run: --entry 14 600 -smp 4
diff --git a/uros/src/mach_kernel/ipc/ipc_right.c b/uros/src/mach_kernel/ipc/ipc_right.c
index 64086bd8..726ba918 100644
--- a/uros/src/mach_kernel/ipc/ipc_right.c
+++ b/uros/src/mach_kernel/ipc/ipc_right.c
@@ -408,6 +408,77 @@ ipc_right_inuse(
  *
  */
 
+/*
+ * 940-widen-dead-name: a dead port's last reference released with a window
+ * held open after it, until the port's memory is back in its zone; then the
+ * window is open 200 us for task_info()'s message, and the zone hands the
+ * port out again, for 940-probe-given-back to ask whether its lock was
+ * taken meanwhile.
+ */
+volatile int	w940_armed;	/* a window is held */
+volatile int	w940_open;	/* and it is open */
+
+/* Before the release: whether it is the port's last.  With the port not
+ * locked, the requests still in flight give their references back first,
+ * and a port goes ahead of this one in the zone's free list, so that this
+ * one, given back, reads as active by the zone's free pointer. */
+static int
+w940_before_release(
+	ipc_port_t	port,
+	boolean_t	unlocked)
+{
+	extern void			delay(int);
+	extern volatile ipc_port_t	w940_watch;
+	extern volatile int		w940_watch_back;
+	ipc_port_t			w;
+	int				i;
+
+	for (i = 0; unlocked && i < 500 && port->ip_references > 1; i++)
+		delay(1);
+	if (port->ip_references != 1)
+		return 0;
+	if (unlocked) {
+		w = ipc_port_alloc_special(ipc_space_kernel);
+		if (w != IP_NULL)
+			ipc_port_dealloc_special(w, ipc_space_kernel);
+	}
+	w940_watch_back = 0;
+	w940_watch = port;
+	w940_armed = 1;
+	return 1;
+}
+
+/* After it: the window, held and opened, and the port handed out again. */
+static void
+w940_after_release(
+	ipc_port_t	port,
+	int		last)
+{
+	extern void			delay(int);
+	extern volatile ipc_port_t	w940_watch;
+	extern volatile int		w940_watch_back;
+	ipc_port_t			w[8];
+	int				i, n;
+
+	if (!last)
+		return;
+	for (i = 0; i < 300000 && !w940_watch_back; i++)
+		delay(1);
+	w940_open = 1;
+	delay(200);
+	w940_open = 0;
+	w940_armed = 0;
+	w940_watch = IP_NULL;
+	for (n = 0; n < 8; ) {
+		w[n] = ipc_port_alloc_special(ipc_space_kernel);
+		if (w[n++] == port)
+			break;
+	}
+	for (i = 0; i < n; i++)
+		if (w[i] != IP_NULL)
+			ipc_port_dealloc_special(w[i], ipc_space_kernel);
+}
+
 boolean_t
 ipc_right_check(
 	ipc_space_t	space,
@@ -465,7 +536,12 @@ ipc_right_check(
 	 * ended, the port went back to its zone, and the entry still named
 	 * it as a send right.
 	 */
-	ipc_port_release(port);
+	{	/* 940-widen-dead-name */
+		int	w940_last = w940_before_release(port, TRUE);
+
+		ipc_port_release(port);
+		w940_after_release(port, w940_last);
+	}
 	return TRUE;
 }
 
@@ -658,8 +734,14 @@ ipc_right_destroy(
 			entry->ie_object = IO_NULL;
 			ipc_entry_dealloc(space, name, entry);
 
-			ip_release(port);
-			ip_check_unlock(port);
+			{	/* 940-widen-dead-name */
+				int	w940_last =
+					w940_before_release(port, FALSE);
+
+				ip_release(port);
+				ip_check_unlock(port);
+				w940_after_release(port, w940_last);
+			}
 			is_write_unlock(space);
 
 			break;
