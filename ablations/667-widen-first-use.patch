Kind: widen
Issue: #667
Holds open: the first use of a statically initialised mutex or condition variable -- the first thread to initialise a static mutex waits 50 ms before it writes the fields, and a thread that comes meanwhile does not, so that with the fix out that second thread initialises the mutex itself and takes it, and the first one's fields then land on its hold; the thread that won a condition variable's swap waits 50 ms before it fills the variable and publishes its signature, so that another thread using it meanwhile finds it being initialised; each wait says so on the console that needs no lock, so that a fixed run that passes shows the window was open; in the fixed tree the second thread waits for the first's initialisation; pthread_test's two first-use cases are what meet it, the first one holding the mutex 100 ms; at most 64 waits of each kind in a task
Run: --entry 14 600 -smp 4

diff --git a/uros/src/lib/libpthreads/pthread_cond.c b/uros/src/lib/libpthreads/pthread_cond.c
index 6a460c56..88115a31 100644
--- a/uros/src/lib/libpthreads/pthread_cond.c
+++ b/uros/src/lib/libpthreads/pthread_cond.c
@@ -56,6 +56,30 @@
  * signature, and the ones that find an initialisation in progress wait for
  * it.  _pthread_mutex_lazy_init() is the same for mutexes.
  */
+/*
+ * ablations/667-widen-first-use.patch: #667's widened window, and not an
+ * ablation.  The thread that won the swap waits WIDEN_667_MS before it fills
+ * the variable and publishes its signature, so that another thread using the
+ * variable meanwhile finds it being initialised: with the fix in it waits,
+ * and with the fix out it answers EINVAL.  Said on the console that needs no
+ * lock.  At most WIDEN_667_TIMES in a task.
+ */
+#define	WIDEN_667_MS		50
+#define	WIDEN_667_TIMES		64
+
+static int	widen_667_inits;	/* not atomic: a budget, not a census */
+
+static void
+widen_667_initialising(void)
+{
+	if (widen_667_inits >= WIDEN_667_TIMES)
+		return;
+	widen_667_inits++;
+	mach_print("#667 widen: a condition variable's initialisation waits "
+		   "50 ms between the swap and the signature\n");
+	(void) thread_switch(MACH_PORT_NULL, SWITCH_OPTION_WAIT, WIDEN_667_MS);
+}
+
 static int
 _pthread_cond_lazy_init(pthread_cond_t *cond)
 {
@@ -92,6 +116,7 @@ _pthread_cond_lazy_init(pthread_cond_t *cond)
 						__ATOMIC_ACQUIRE,
 						__ATOMIC_ACQUIRE))
 		{
+			widen_667_initialising();
 			LOCK_INIT(cond->lock);
 			cond->next = (pthread_cond_t *)NULL;
 			cond->prev = (pthread_cond_t *)NULL;
diff --git a/uros/src/lib/libpthreads/pthread_mutex.c b/uros/src/lib/libpthreads/pthread_mutex.c
index b1eb3f74..40e5c55f 100644
--- a/uros/src/lib/libpthreads/pthread_mutex.c
+++ b/uros/src/lib/libpthreads/pthread_mutex.c
@@ -54,12 +54,50 @@ pthread_mutex_destroy(pthread_mutex_t *mutex)
  * written: this wrote the signature first and then returned EINVAL for a bad
  * attribute, leaving a mutex that said it was valid and was not.
  */
+/*
+ * ablations/667-widen-first-use.patch: #667's widened window, and not an
+ * ablation.  The first thread to initialise a static mutex waits WIDEN_667_MS
+ * before it writes the fields, and a thread that comes while it waits does
+ * not.  With the fix in, that second thread finds the initialisation in
+ * progress and waits for it; with the fix out it initialises the mutex
+ * itself and takes it, and the first one's fields then land on its hold.
+ * Said on the console that needs no lock -- printf() may take a mutex -- so
+ * that a fixed run that passes shows the window was open.  At most
+ * WIDEN_667_TIMES in a task.
+ */
+#define	WIDEN_667_MS		50
+#define	WIDEN_667_TIMES		64
+
+static volatile int	widen_667_waiting;
+static int		widen_667_inits;	/* a budget, not a census */
+
+static void
+widen_667_first_init(pthread_mutex_t *mutex)
+{
+	int none = 0;
+
+	/* Only a static mutex's first use: not pthread_mutex_init() itself. */
+	if (mutex->sig != _PTHREAD_MUTEX_SIG_init &&
+	    mutex->sig != _PTHREAD_MUTEX_SIG_initing)
+		return;
+	if (widen_667_inits >= WIDEN_667_TIMES ||
+	    !__atomic_compare_exchange_n(&widen_667_waiting, &none, 1, 0,
+					 __ATOMIC_ACQ_REL, __ATOMIC_RELAXED))
+		return;
+	widen_667_inits++;
+	mach_print("#667 widen: the first thread to initialise a static mutex "
+		   "waits 50 ms\n");
+	(void) thread_switch(MACH_PORT_NULL, SWITCH_OPTION_WAIT, WIDEN_667_MS);
+	__atomic_store_n(&widen_667_waiting, 0, __ATOMIC_RELEASE);
+}
