@@ -1000,11 +1000,36 @@ printf_nested(void)
  * the putc callback in _doprnt and as a direct cnputc wrapper for
  * the MP cpu-number prefix.
  */
+/*
+ * #702 widen: the processor halt_test.c's chatter runs on is held inside the
+ * first line it starts once a panic's message is out, after its first byte,
+ * with printf_lock held, until another processor holds the console's report;
+ * then the line goes on, each byte waiting for that report as such bytes do --
+ * as the processor halted inside printf() in the campaign's boots was.  After
+ * the first byte, and not further in: the bytes after it wait for every
+ * report, and a hold reached once they were all said would wait for one that
+ * never comes.  And once panic() says its message is out, which it says with a
+ * flag of the widen's own: panicstr is set before panicwait, and a chatter
+ * held between the two stores held the message itself up.
+ */
+volatile int		printf_702_cpu = -1;
+static unsigned		printf_702_n;
+extern volatile int	panic_702_said;
+extern int		cons_report_held_elsewhere(void);
+
 static void
 klog_cnputc(char c)
 {
 	cnputc(c);
 	klog_putc(c);
+	if (printf_702_cpu == cpu_number() && panic_702_said &&
+	    ++printf_702_n == 1) {
+		unsigned long long i;
+
+		for (i = 0; i < (1ULL << 32) && !cons_report_held_elsewhere();
+		     i++)
+			__asm__ volatile("pause");
+	}
 }
 
