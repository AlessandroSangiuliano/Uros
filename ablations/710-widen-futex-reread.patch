+/*
+ * #710 widen: a futex waiter held between its two reads, so that another
+ * thread of its task can take the page away in between.  Only for a word
+ * holding WIDEN_710_WORD, pthread_test's, and at most WIDEN_710_BUDGET times.
+ * The hold is a spin of WIDEN_710_MS at splsched with the wait declared, the
+ * state the window is in; the shootdown the unmap sends is class 15 and
+ * reaches it.  The line is said before splsched, where printf() can take what
+ * it needs.
+ */
+#define	WIDEN_710_WORD		0x07100710u
+#define	WIDEN_710_MS		100
+#define	WIDEN_710_BUDGET	16
+
+static volatile int	widen_710_left = WIDEN_710_BUDGET;
+
+static boolean_t
+widen_710_wanted(unsigned int word)
+{
+	if (word != WIDEN_710_WORD || widen_710_left <= 0)
+		return FALSE;
+	widen_710_left--;
+	printf("#710 widen: a futex waiter held %d ms between its two reads\n",
+	       WIDEN_710_MS);
+	return TRUE;
+}
+
+static void
+widen_710_hold(void)
+{
+	int	ms;
+
+	for (ms = 0; ms < WIDEN_710_MS; ms++)
+		delay(1000);
+}
