 	urmach_rcu_read_unlock();
 
+	/*
+	 * #570's ablation: the holder of a PCI I/O BAR is refused its own
+	 * registers after `allowed' accesses, so that the driver's refusal path
+	 * runs on a real boot.  On x86-64's board the one such holder is
+	 * virtio-blk, and #570 asked it at 0, the first access of its probe; at
+	 * 11, the probe's last, the read of the status; at 40, a request's
+	 * notify; and at 13, the acknowledge of an interrupt, on a board with
+	 * MSI-X off (-global virtio-blk-pci.vectors=0).  The count is not
+	 * atomic: this is an experiment, run on one processor, and it is never
+	 * built otherwise.
+	 */
+	if (mine) {
+		static unsigned int	ablate_570_seen;
+		const unsigned int	allowed = 0;
+		unsigned int		n = ablate_570_seen++;
+
+		if (n >= allowed) {
+			if (n == allowed)
+				printf("device_io_port: #570 ablation — refusing "
+				       "0x%x to the holder of its own BAR, after "
+				       "%u allowed accesses\n", port, n);
+			return KERN_NO_ACCESS;
+		}
+	}
 	if (mine)
 		return KERN_SUCCESS;
