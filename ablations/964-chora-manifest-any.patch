+++ b/uros/src/servers/hal_server/hal_modules.c
@@ -217,8 +217,7 @@ chora_start(const struct hal_device_info *dev, const char *pool,
 
 	memset(&want, 0, sizeof want);
 	want.type = RESOURCE_PCI_FUNCTION;
-	want.resource_id = (uint64_t)(dev->bus << 8 | dev->slot << 3 |
