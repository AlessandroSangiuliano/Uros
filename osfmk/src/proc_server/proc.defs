/*
 * proc.defs — MIG interface for proc_server (#237 v0.1.0).
 *
 * Subsystem 3200.  Three routines in v0.1.0:
 *   proc_register         — register a freshly-spawned task, get pid
 *   proc_subscribe_exit   — register a notify port; one-shot mach msg
 *                           is sent there when the pid becomes zombie
 *   proc_list             — debug enumerate, precursor to ps(1)
 *
 * waitpid POSIX semantics live in libposix-uros (future) and are
 * implemented client-side as: subscribe + mach_msg_receive on the
 * notify port.  proc_server stays single-threaded with no parked
 * reply ports.
 *
 * Naming uses the migcom serverstripprefix extension (#227):
 *   user stub  : proc_register / proc_wait / proc_list
 *   server impl: proc_S_register / proc_S_wait / proc_S_list
 *
 * The /proc filesystem (vfs.defs) is exposed via a separate
 * subsystem chain in the demux — see proc_main.c.
 */

subsystem
#if	KERNEL_SERVER
	  KernelServer
#endif	/* KERNEL_SERVER */
		       proc 3200;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

serverprefix		proc_S_;
serverstripprefix	proc_;

import "proc_types.h";

type proc_pid_t       = unsigned    ctype: proc_pid_t;
type proc_cmdline_t   = c_string[*:128];
type proc_entry_t     = struct[36] of unsigned32;     /* 144 bytes */
type proc_entry_array = pointer_t   ctype: proc_entry_array;
type proc_rusage_t    = struct[10] of unsigned32      /* 40 bytes  */
                          ctype: proc_rusage_t;

/*
 * Register a task with proc_server.  The caller passes a send right
 * to the new task's port; proc_server installs a DEAD_NAME notify on
 * it so it can detect termination and mark the pid zombie.
 *
 *   parent_pid — 0 (PROC_PID_NONE) for no parent
 *   task_port  — task to track
 *   cmdline    — command name (truncated to PROC_CMDLINE_MAX)
 *
 *   new_pid    — server-assigned pid (>= PROC_PID_INIT + 1 today)
 *   result     — PROC_OK or PROC_ERR_*
 */
routine proc_register(
		proc_port	: mach_port_t;
	in	parent_pid	: proc_pid_t;
	in	task_port	: mach_port_t;
	in	cmdline		: proc_cmdline_t;
	out	new_pid		: proc_pid_t;
	out	result		: int);

/*
 * Subscribe a notify port to the named pid's exit.  proc_server saves
 * the send-once right and, when the pid becomes a zombie, sends a
 * single proc_exit_msg_t (see proc_types.h) to it.  If the pid is
 * already a zombie, the notification fires immediately.  v0.1.0
 * keeps a single waiter slot per pid — concurrent subscribers race;
 * v0.x.0 generalises to a list.
 */
routine proc_subscribe_exit(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	in	notify_port	: mach_port_make_send_once_t;
	out	result		: int);

/*
 * Enumerate all known pids (running + zombies).  Caller passes an
 * out array; server fills it.  v0.1.0 returns up to PROC_MAX_TASKS
 * entries; truncation is signalled with PROC_ERR_TOO_MANY but the
 * filled prefix is still valid.
 */
routine proc_list(
		proc_port	: mach_port_t;
	out	entries		: proc_entry_array;
	out	count		: unsigned;
	out	result		: int);

/*
 * Register a signal_port for a pid (#238 / v0.2.0).  The caller passes
 * a send right; proc_server stores it and uses it on every subsequent
 * proc_kill for that pid (catchable signals) and on SIGCHLD delivery
 * to the parent.  Re-calling replaces the previous port (old send right
 * is deallocated server-side).  v0.2.0 keeps one signal_port per pid;
 * a future pthread_sigmask might want per-thread, but that policy
 * lives in libposix-uros.
 */
routine proc_set_signal_port(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	in	signal_port	: mach_port_t;
	out	result		: int);

/*
 * Send a signal to a pid (#238 / v0.2.0).
 *   SIGKILL  → task_terminate(target.task_port)         (uncatchable)
 *   SIGSTOP  → task_suspend(target.task_port)           (uncatchable)
 *   SIGCONT  → task_resume(target.task_port)
 *   any other valid signo → mach_msg(proc_signal_msg_t) on
 *                           target.signal_port (PROC_ERR_NO_SIGPORT
 *                           if none registered).
 *
 * sender_pid is wire-filled server-side with PROC_PID_NONE — v0.2.0
 * doesn't yet authenticate the caller; libposix-uros will pass
 * getpid() once it learns its own pid.  (Reserved for v0.3.0.)
 */
routine proc_kill(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	in	signo		: int;
	out	result		: int);

/*
 * POSIX session / process group routines (#239 / v0.3.0).
 *
 *   setsid(pid)            — pid becomes leader of a new session and
 *                            a new pgrp (both == pid).  EPERM if pid
 *                            is already a pgrp leader (POSIX).
 *   setpgid(pid, pgrp)     — move pid to pgrp.  pgrp must already
 *                            exist in pid's session (or pgrp == pid,
 *                            which creates a new pgrp).  pgrp == 0
 *                            means "use pid".
 *   getpgid(pid) / getsid  — read-only lookup; out_pgrp/out_sid 0
 *                            on PROC_ERR_NOT_FOUND.
 *   killpg(pgrp, signo)    — send signo to every pid whose pgrp_id
 *                            == pgrp (excluding zombies).  Returns
 *                            PROC_OK if at least one pid received
 *                            it; n_sent is the count, useful for
 *                            tests.  signo follows proc_kill rules
 *                            (catchable → mach_msg, uncatchable →
 *                            task op).
 */
routine proc_setsid(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	out	new_sid		: proc_pid_t;
	out	result		: int);

routine proc_setpgid(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	in	pgrp		: proc_pid_t;
	out	result		: int);

routine proc_getsid(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	out	sid		: proc_pid_t;
	out	result		: int);

routine proc_getpgid(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	out	pgrp		: proc_pid_t;
	out	result		: int);

routine proc_killpg(
		proc_port	: mach_port_t;
	in	pgrp		: proc_pid_t;
	in	signo		: int;
	out	n_sent		: unsigned;
	out	result		: int);

/*
 * proc_getrusage(pid) — POSIX-style resource snapshot for a pid
 * (#240 / v0.4.0).  proc_server forwards the call into the kernel
 * via task_info(task_port, TASK_BASIC_INFO + TASK_EVENTS_INFO),
 * marshals the result into proc_rusage_t, and returns it inline.
 *
 * Returns PROC_ERR_NOT_FOUND if the pid is unknown, PROC_ERR_KERNEL
 * if any of the underlying task_info calls fails.  Zombies are
 * permitted: the last-snapshot values stick until the slot is
 * reused (today the slot is never recycled — see v0.1.0 notes).
 */
routine proc_getrusage(
		proc_port	: mach_port_t;
	in	pid		: proc_pid_t;
	out	usage		: proc_rusage_t;
	out	result		: int);
