/*
 * mach_klog.defs — kernel printf ring buffer drain (#200).
 *
 * Tiny one-routine subsystem so userspace (bootstrap's log_forwarder
 * pthread, future dmesg-like tool) can pull printf output out of the
 * kernel ring buffer without intercepting cnputc at the driver
 * level.
 */

subsystem
#if	KERNEL_SERVER
	  KernelServer
#endif	/* KERNEL_SERVER */
		       mach_klog 4200;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

type klog_data_t = array[*:4096] of char;

/*
 * host_get_log: drain bytes written to the kernel ring since `start`.
 *
 *   host     - any host port name (we don't require host_priv: any
 *              task can see printf — same threat model as the serial
 *              console).
 *   start    - cursor returned by the previous call; pass 0 on the
 *              first call to start from the oldest still-buffered byte.
 *   buf      - up to 4096 bytes copied out; the count returned may
 *              be less if fewer bytes are available.
 *   next     - new cursor; pass back unchanged next call.
 *
 * The cursor is 32-bit and modular: if the reader falls more than
 * KLOG_BUF_SIZE (64 KiB) behind, the kernel silently snaps the
 * cursor to the oldest still-buffered byte.  Drop-on-loss matches
 * design doc §11.3 rule 2 — never block printf for a slow drainer.
 */
routine host_get_log(
		host		: host_t;
		start		: natural_t;
	out	buf		: klog_data_t, CountInOut;
	out	next		: natural_t);
