/*
 * 	File:	netname.defs
 *	Author:	Dan Julin, Carnegie Mellon University
 *	Date:	May 1989
 *
 * 	Mig definitions for Network Name Service.
 */

subsystem netname 1040;

serverprefix do_;

#include <mach/std_types.defs>

/*
 * ⚠️ The sizes are NOT literals here.  This file runs through cpp before
 * migcom sees it, so it takes them from the same header the C side does --
 * <servers/netname_size.h>, which holds preprocessor definitions and nothing
 * else for exactly this reason.  They were 128 here and 80 there, and nothing
 * in either language compared them.
 */
#include <servers/netname_size.h>

type netname_name_t	= c_string[*:NETNAME_NAME_MAX];

/*
 * The same name, as an INPUT.
 *
 * ⚠️ Two types for one thing, and the difference is the direction.  An `out'
 * name is written into a buffer the caller supplies, so `char[N]' is the
 * truth: the caller really must provide N bytes and the compiler should say
 * so.  An `in' name is only READ, and mig_strncpy stops at the terminator --
 * it never touches N bytes.  Declaring the parameter as an array made every
 * call site promise storage it does not have, and gcc said so at each one:
 *
 *   netname_test.c:95: 'netname_check_in' accessing 128 bytes in a region of
 *                      size 13 [-Wstringop-overflow=]
 *
 * A diagnosis that fires on correct code at every call site is one people
 * learn to skip, and this file's neighbours were built with -w partly for
 * that reason.  So the input takes a pointer, which is what it is.
 */
type netname_name_in_t	= c_string[*:NETNAME_NAME_MAX]
				ctype: netname_name_in_t;

/*
 * netname_path_t — full filesystem path (mount lookup input).
 * Sized for a typical PATH_MAX; the mount registry entries
 * (prefixes) fit in netname_name_t.
 */
type netname_path_t	= c_string[*:NETNAME_PATH_MAX];

/* The same, for a path that is only read.  See netname_name_in_t. */
type netname_path_in_t	= c_string[*:NETNAME_PATH_MAX]
				ctype: netname_path_in_t;

import <servers/netname_defs.h>;

routine netname_check_in(
	server_port	: mach_port_t;
	port_name	: netname_name_in_t;
	signature	: mach_port_copy_send_t;
	port_id		: mach_port_make_send_t);

routine netname_look_up(
	server_port	: mach_port_t;
	host_name	: netname_name_in_t;
	port_name	: netname_name_in_t;
    out	port_id		: mach_port_move_send_t);

routine netname_check_out(
	server_port	: mach_port_t;
	port_name	: netname_name_in_t;
	signature	: mach_port_copy_send_t);

routine netname_version(
	server_port	: mach_port_t;
    out	version		: netname_name_t);

routine netname_register_send_right(
	server_port	: mach_port_t;
	port_name	: netname_name_in_t;
	signature	: mach_port_copy_send_t;
	port_id		: mach_port_copy_send_t);

routine netname_debug_on(
	server_port	: mach_port_t);

routine netname_debug_off(
	server_port	: mach_port_t);

/*
 * Register for notification when a service name becomes available.
 * If the service is already registered, the notification is sent
 * immediately.  Otherwise, a one-shot notification is sent when
 * the service calls netname_check_in().
 */
routine netname_notify(
	server_port	: mach_port_t;
	port_name	: netname_name_in_t;
	notify_port	: mach_port_make_send_once_t);

/*
 * Mount registry (#220 sub-step C).  A separate keyspace from the
 * service-name table above: mount keys are filesystem path prefixes
 * (absolute, with leading '/') and lookup is longest-segment-match
 * rather than exact.  Used by libvfs to route fs_open() to the right
 * fs_server without per-client hardcoded knowledge of who owns what.
 */

routine netname_check_in_mount(
	server_port	: mach_port_t;
	prefix		: netname_name_in_t;
	signature	: mach_port_copy_send_t;
	port_id		: mach_port_make_send_t);

routine netname_check_out_mount(
	server_port	: mach_port_t;
	prefix		: netname_name_in_t;
	signature	: mach_port_copy_send_t);

/*
 * Longest-prefix mount lookup.
 *   path    — absolute filesystem path (e.g. "/mnt/disk1/etc/passwd")
 *   port_id — send right of the matching mount's owner
 *   matched — the prefix that matched (caller strips it to get the
 *             path relative to the mount, if needed)
 */
routine netname_look_up_mount(
	server_port	: mach_port_t;
	path		: netname_path_in_t;
    out	port_id		: mach_port_move_send_t;
    out	matched		: netname_name_t);

/*
 * Enumerate every registered mount prefix (#284).  Returns the prefixes
 * newline-separated in a single buffer (caller splits on '\n') plus the
 * count.  Used by proc_server's shutdown drain to walk the registry and
 * fs_sync each mount before host_reboot.  No port rights are handed out
 * here — the caller re-resolves each prefix via netname_look_up_mount.
 */
routine netname_list_mounts(
	server_port	: mach_port_t;
    out	prefixes	: netname_path_t;
    out	count		: int);

