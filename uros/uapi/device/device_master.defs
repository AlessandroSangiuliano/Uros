/*
 * device/device_master.defs
 *
 * MIG interface for kernel primitives needed by userspace drivers.
 * These RPCs are sent to the master_device_port (privileged).
 *
 * Subsystem 2900 — separate from device (2800).
 */

subsystem
#if	KERNEL_SERVER
	  KernelServer
#endif	/* KERNEL_SERVER */
		       device_master 2900;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>
#include <device/device_types.defs>

/*
 * A capability token, as an opaque blob (#432, #216).
 *
 * ⚠️ Declared here rather than imported from cap_server.defs, which is a
 * different subsystem: what crosses this interface is the same BYTES and not
 * the same MIG type, and a cross-subsystem type import would tie this
 * interface's wire format to that one's.  CAP_TOKEN_MAX is the bound both
 * agree on, and <mach/cap_types.h> is where it is stated once.
 */
type cap_token_t = array[*:256] of char;
import <mach/cap_types.h>;

serverprefix	ds_master_;

/*
 * PCI configuration space read.
 * Returns a 32-bit value from the specified BDF + register.
 */
routine device_pci_config_read(
		master_port	: mach_port_t;
	in	bus		: natural_t;
	in	slot		: natural_t;
	in	func		: natural_t;
	in	reg		: natural_t;
	out	data		: natural_t
	);

/*
 * PCI configuration space write.
 * Writes a 32-bit value to the specified BDF + register.
 */
routine device_pci_config_write(
		master_port	: mach_port_t;
	in	bus		: natural_t;
	in	slot		: natural_t;
	in	func		: natural_t;
	in	reg		: natural_t;
	in	data		: natural_t
	);

/*
 * Register an IRQ notification.
 * When the specified IRQ fires, the kernel sends a simple
 * notification message to notify_port.  Only one registration
 * per IRQ is allowed.
 */
routine device_intr_register(
		master_port	: mach_port_t;
	in	irq		: natural_t;
	in	notify_port	: mach_port_send_t
	);

/*
 * Ask for a device's message-signalled interrupt (#457).
 *
 * 🔴 THE DRIVER NEVER SEES AN ADDRESS, and that is the whole shape of this
 * call.  An MSI-X table entry holds an address the DEVICE will write to, so a
 * driver that could fill one in could point the device at page zero, at
 * another task's pages, or at another processor's local APIC -- and no fault
 * would be raised, because the write belongs to the device and not to the
 * driver.  That is #432's hole for DMA and #511's for the master port,
 * arriving through a third door.
 *
 * So the driver says WHICH DEVICE and WHICH ENTRY of that device's table, and
 * the kernel finds the capability, allocates a vector, decides the address
 * and the value, and writes them there itself.
 *
 * `slot' comes back in the same numbering as an IRQ, and is what
 * device_intr_enable and device_intr_unregister take afterwards -- a driver
 * that has one does not need to know which kind it is.
 *
 * ⚠️ Fails on a machine that has no MSI at all rather than pretending: i386
 * reaches every device through a wire.
 */
routine device_msi_register(
		master_port	: mach_port_t;
	in	bus		: natural_t;
	in	dev		: natural_t;
	in	func		: natural_t;
	in	entry		: natural_t;
	in	notify_port	: mach_port_send_t;
	out	slot		: natural_t
	);

/*
 * Unregister an IRQ notification.
 */
routine device_intr_unregister(
		master_port	: mach_port_t;
	in	irq		: natural_t
	);

/*
 * Re-enable (unmask) an IRQ at the PIC after the userspace driver has
 * processed a forwarded notification.  The top-half handler masks the
 * line on delivery to prevent level-triggered re-fire while the message
 * is in flight; the driver must call this RPC after clearing the
 * device-side status register (#222).
 *
 * Idempotent / no-op for IRQs that are already unmasked or never
 * registered — drivers can call it uniformly regardless of trigger mode.
 */
routine device_intr_enable(
		master_port	: mach_port_t;
	in	irq		: natural_t
	);

/*
 * ── An address widens, a number does not (#427) ──────────────────────
 *
 * Everything below used to be natural_t, which is 32 bits on both targets by
 * decision -- it is what mach_port_t is built on, and widening it would
 * double the header of every message and every port array to no purpose.
 * That was right for the counts and wrong for the addresses, and on i386
 * nobody could tell, because there vm_address_t IS natural_t.
 *
 * 🔑 So this change costs i386 nothing: the generated stubs are byte-identical
 * across it, which is the cheapest possible regression test and is checked.
 * On x86-64 it is the difference between an interface that can name a device
 * above four gigabytes and one that cannot -- and, sharper, between one that
 * can return a user virtual address and one that truncates it.
 *
 * ⚠️ dma_sg_addr_t below was the one NOT widened here, on the grounds that
 * doubling an inline element took the message from 16 to 32 KiB.  That was
 * right about the cost and wrong about the conclusion: the answer was to stop
 * carrying it inline, not to keep it narrow.  Widened and moved out of line by
 * #520 -- see the note on the type itself.
 *
 * What stays natural_t: bus, slot, func, reg, data, irq, the I/O port number
 * and n_pages.  They are numbers, not addresses.
 */


/*
 * ── Which device a DMA buffer is FOR (#432) ──────────────────────────
 *
 * 🔴 THE KERNEL DID NOT KNOW.  device_dma_alloc took a size and returned a
 * physical address, and #457 closed leaving that written down as this issue's
 * work: "a userspace driver server does DMA to a buffer it does not know the
 * physical address of -- today it knows by construction".  It cannot stop
 * knowing until the kernel can tell which device is going to read it, because
 * that is what decides which IOMMU domain the buffer belongs in.
 *
 * So the three calls that hand out addresses a device will use now say whose
 * device it is.  One argument and not three, because a bus/device/function
 * triple has a canonical packing and a spare value:
 *
 *	bdf = (bus << 8) | (dev << 3) | func
 *
 * 🔑 DEVICE_DMA_NO_BDF is not zero.  Zero is a REAL address -- 0:0.0 is the
 * host bridge on every machine this runs on -- so a caller that forgot the
 * argument would have silently claimed to be it.  It is a value the packing
 * cannot produce.
 *
 * ⚠️ And there is a caller that legitimately has no device: ext_server
 * allocates scatter-gather pages that the BLOCK SERVER's disk will read,
 * not any device of its own.  It passes DEVICE_DMA_NO_BDF and receives an
 * untranslated physical address -- which the block server then programs into a
 * disk that IS confined, so the transfer is refused and the fault names the
 * page.  🔑 That is the hole working as designed rather than the hole being
 * closed: before this it was made silently and succeeded.  The right shape is
 * for the server that owns the device to do the mapping, which is a protocol
 * change with #498 in it.
 *
 * ⚠️ The constant itself lives in <device/device_types.h> and not here: MIG
 * does not carry a #define from a .defs into the header it generates, so a
 * definition here would be visible to nobody and the first caller to use it
 * would fail to compile with a name that looks misspelt.
 */

/*
 * ── A device that cannot be given an address it must translate ───────
 *
 * Declare that this device must be programmed with PHYSICAL addresses, so its
 * domain maps every grant at the address the memory is really at.
 *
 * 🔴 THIS IS NOT AN OPT-OUT OF ISOLATION.  The device is still confined: it
 * reaches what it has been granted and nothing else, and every other address
 * in the machine faults for it.  What it gives up is the second property #432
 * stage 3e added -- not knowing where its memory is.  Confinement stops a
 * device reaching elsewhere by accident; the IOVA stops it doing so on
 * purpose, and this keeps the first and loses the second.
 *
 * 🔑 AND IT IS A REAL CONSTRAINT AND NOT A CONVENIENCE.  A LEGACY virtio
 * device is specified to take physical addresses: without
 * VIRTIO_F_ACCESS_PLATFORM there is no negotiation in which it could be told
 * otherwise, and this tree's virtio driver is the legacy interface -- I/O port
 * BAR0, configuration at 0x14.  Handed an IOVA it programs it as a physical
 * address and the transfer lands nowhere, which is a request timeout and no
 * other symptom.  The fix is virtio 1.0, and that is a driver rewrite.
 *
 * ⚠️ A driver could ask for this to learn its own physical addresses, and
 * nothing here stops it.  That is why the kernel says so ON THE CONSOLE, once
 * per device: a weakening that is announced is a weakening somebody can
 * notice, and this interface has exactly one legitimate caller today.
 *
 * ⚠️ Must be called BEFORE the device's first device_dma_alloc.  The domain is
 * created by the first grant, and a domain that already holds translated
 * buffers cannot become an identity one without moving them.  Answers
 * KERN_FAILURE if the device already has a domain.
 */
routine device_dma_identity(
		master_port	: mach_port_t;
	in	bdf		: natural_t
	);

/*
 * Allocate a physically contiguous DMA buffer.  Answers the kernel virtual
 * address and THE ADDRESS THE DEVICE MUST BE PROGRAMMED WITH.
 *
 * 🔴🔴 `dma_addr' AND NOT `paddr', AND THE RENAME IS THE CHANGE (#432 stage
 * 3e).  On a machine that confines this device it is an IOVA: a number that
 * means something only inside that device's IOMMU domain.  Another device
 * given it reaches nothing; the processor cannot use it at all; and the driver
 * no longer knows where in physical memory its buffer is.  That was #457's
 * closing clause and it is now true.
 *
 * 🔑 On a machine with no remapping hardware, or booted without it, the same
 * field carries the physical address exactly as it always did.  One interface
 * answers both, and no driver has to know which kind of machine it is on --
 * which is why this is a change of MEANING and not of protocol.  The parameter
 * has always been "the address to program"; it just used to have only one
 * possible value.
 *
 * ⚠️ It is therefore NOT an address to hand to anything else.  device_dma_free
 * and device_dma_map_user take the KERNEL address, and a caller that passed
 * this one to a second server would be passing a number that is private to one
 * device's domain.
 */
routine device_dma_alloc(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	in	size		: vm_size_t;
	out	vaddr		: vm_address_t;
	out	dma_addr	: vm_address_t
	);

/*
 * Free a previously allocated DMA buffer.
 */
routine device_dma_free(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	in	vaddr		: vm_address_t;
	in	size		: vm_size_t
	);

/*
 * Map a kernel DMA buffer (kernel VA from device_dma_alloc) into a
 * user task's address space.  Returns the user virtual address.
 */
routine device_dma_map_user(
		master_port	: mach_port_t;
	in	kva		: vm_address_t;
	in	size		: vm_size_t;
	in	task_port	: mach_port_t;
	out	uva		: vm_address_t
	);

/*
 * Map a physical MMIO range (e.g. a PCI BAR) into a user task's
 * address space.  Returns the user virtual address.
 */
routine device_mmio_map(
		master_port	: mach_port_t;
	in	phys_addr	: vm_address_t;
	in	size		: vm_size_t;
	in	task_port	: mach_port_t;
	out	uva		: vm_address_t
	);

/*
 * Unmap an MMIO range from a user task.
 */
routine device_mmio_unmap(
		master_port	: mach_port_t;
	in	uva		: vm_address_t;
	in	size		: vm_size_t;
	in	task_port	: mach_port_t
	);

/*
 * Allocate a scatter-gather DMA buffer: n_pages individually wired
 * pages mapped contiguously into the caller's address space.
 * Returns the kernel VA (handle for free), user VA, and an array
 * of physical addresses (one per page) for programming PRDTs.
 * Unlike device_dma_alloc, pages need NOT be physically contiguous.
 */
/*
 * ── Out of line, and 64 bits wide (#520) ─────────────────────────────
 *
 * It was `array[*:4096] of natural_t' -- inline, and 32 bits per element on
 * both targets.  Two things were wrong with that and only one of them was the
 * width.
 *
 * 🔴 THE WIDTH.  Each element is the BYTE address of a 4 KiB page, so 32 bits
 * put a ceiling of four gigabytes on what a scatter-gather list could name.  On
 * a 64-bit kernel that is a hole, not a limitation: the allocator may hand back
 * a frame above it and the list simply could not say so.
 *
 * 🔴 THE SHAPE, which is what made the width unaffordable.  A variable-length
 * INLINE array costs its declared MAXIMUM as a stack frame -- migcom puts
 * `union { Request; Reply; } Mess' on the stack -- while copying and sending
 * only the actual count.  So 4096 elements were 16 KiB of frame in a 64 KiB
 * thread stack, and widening them would have made it 32.  ext_server has its
 * own pa_list[4096] in the calling frame on top of that: 32 KiB of 64, already,
 * on i386.
 *
 * Out of line, the array travels as a memory region and the frame holds a
 * pointer.  The cost is one vm_map_copyin per call, and this call happens once
 * per controller or per mount -- it allocates a buffer, it does not transfer.
 *
 * ⚠️ NOT the right answer for the per-I/O lists.  device_read_phys and
 * device_write_phys carry one to thirty-two addresses on EVERY disk request,
 * and out-of-line there would be page-table work plus a kernel allocation to
 * move eight bytes.  Those stay inline; see ahci_batch.defs, where the cap is
 * PRDT_PER_SLOT and not a round number.
 *
 * ⚠️ THE CALLER MUST vm_deallocate WHAT IT GETS BACK.  That is the price of
 * out-of-line memory and the one way this change can leak.
 */
type dma_sg_addr_t = ^array[] of vm_address_t;

/*
 * 🔴🔴 AND THE LIST IS ADDRESSES THE DEVICE USES, NOT PHYSICAL ONES (#432
 * stage 3e).  On a machine that confines this device the pages are granted
 * TOGETHER and get CONSECUTIVE addresses, so the list comes back as
 * base, base+4096, base+8192, ...  -- a scatter-gather buffer that is
 * scattered in physical memory and contiguous in the device's.
 *
 * 🔑 Which means a driver could program it as one region.  Nothing here does
 * yet: they build the multi-entry PRDT they always built, which is still
 * correct and is what a machine with no remapping hardware needs -- there the
 * list is physical addresses and genuinely scattered.  A driver that wants the
 * shorter descriptor has to check that the list is consecutive rather than
 * assume it, and that is a driver-side change this does not make for it.
 */
routine device_dma_alloc_sg(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	in	n_pages		: natural_t;
	in	task_port	: mach_port_t;
	out	kva		: vm_address_t;
	out	uva		: vm_address_t;
	out	dma_addrs	: dma_sg_addr_t
	);

/*
 * I/O port read.
 * Reads 1, 2, or 4 bytes from the specified x86 I/O port.
 */
routine device_io_port_read(
		master_port	: mach_port_t;
	in	port		: natural_t;
	in	size		: natural_t;
	out	data		: natural_t
	);

/*
 * I/O port write.
 * Writes 1, 2, or 4 bytes to the specified x86 I/O port.
 */
routine device_io_port_write(
		master_port	: mach_port_t;
	in	port		: natural_t;
	in	size		: natural_t;
	in	data		: natural_t
	);

/*
 * #382: userspace console-break entry into the kernel debugger.
 * The serial/keyboard drivers live in char_server, so the kernel never
 * sees their RX bytes; when a driver spots the break key (Ctrl+D) it
 * calls this instead.  Gated kernel-side by the -K boot flag
 * (ddb_kbd_break_enabled): returns KERN_FAILURE when not armed, and the
 * driver then delivers the byte as normal input.  When armed, the call
 * enters DDB and returns only when the operator continues.
 */
routine device_ddb_break(
		master_port	: mach_port_t
	);

/*
 * ── Was it the IOMMU that refused my transfer? (#432 stage 3d) ────────
 *
 * How many DMA requests from this device the remapping hardware has blocked,
 * and the last address it blocked.
 *
 * 🔴 A DRIVER CANNOT TELL THIS FROM A BROKEN DEVICE, and that is the whole
 * reason this exists.  A transfer refused by the IOMMU does not complete: the
 * command times out, the port reports nothing useful, and every symptom is
 * identical to a disk that stopped answering.  What is different is knowable
 * only inside the kernel, where the engine writes its fault records -- so
 * either the kernel offers the answer or every driver debugs the wrong thing.
 *
 * 🔴 `confined' IS WHY THERE ARE THREE ANSWERS AND NOT TWO.  A count of zero
 * means "the IOMMU did not refuse you", and that is true on a machine with no
 * remapping hardware, on one booted without it, and on one where the device is
 * behaving -- three states a driver must tell apart.  Without this field, a
 * self-test that DEMONSTRATES the isolation cannot tell "the transfer was
 * allowed because nothing polices this machine" from "the transfer was allowed
 * although something does", and the second is a security failure while the
 * first is a Tuesday.
 *
 * `count' is since boot and does not wrap with the kernel's log; `address' is
 * the last one recorded and is meaningless when the count is zero.
 */
/*
 * Is this device already driven by ANOTHER task?
 *
 * 🔴 A QUESTION THAT DOES NOT CLAIM, and that is the whole reason it exists
 * rather than a caller finding out by trying.  A device is claimed by the
 * first task that maps memory for it, so "try it and see" is a test that
 * STEALS the device when the answer is no -- and the driver that was going to
 * claim it is then refused, which is a self-test breaking the thing it was
 * checking.
 *
 * ⚠️ Answers zero for a device nobody drives AND for one this task drives
 * itself.  Those are the two cases in which the caller may go on to map for
 * it, which is what the caller is asking.
 */
/*
 * ── The server that owns the device does the mapping (#432) ──────────
 *
 * Make one page of a DMA buffer somebody ELSE allocated reachable by MY
 * device, and answer the address to program.
 *
 * 🔴 THIS IS THE `DEVICE_DMA_NO_BDF' HOLE CLOSED.  ext_server allocates
 * scatter-gather pages that the block server's disk reads, and names no device
 * because it owns none -- so once that disk is confined the pages are in
 * nobody's domain and every transfer into them is refused.  Correct,
 * diagnosable, and useless.  The shape this issue asks for is that the server
 * which owns the device maps them, and this is that call.
 *
 * 🔑 THE KERNEL VERIFIES THE PAGE.  `paddr' must belong to a live buffer this
 * kernel allocated through device_dma_alloc or device_dma_alloc_sg -- anything
 * else is refused.  Without that, "map this address for my device" would be a
 * request to put ARBITRARY physical memory inside a device's reach, which is
 * the whole thing being prevented.
 *
 * 🔑 And the WHOLE REGION is mapped on the first page of it, at consecutive
 * addresses.  So the caller asks per page and pays once: after the first
 * answer the rest are arithmetic, the kernel's record of the grant is one
 * entry rather than a thousand, and the region is revoked in one step when its
 * owner frees it.
 *
 * ⚠️ Only the task that drives `bdf' may call this — a device has one driver.
 *
 * ⚠️ It narrows and does not close.  Any holder of the master port can map any
 * page the kernel allocated for DMA: not any page in the machine, which is
 * where this started, but not only the ones somebody handed it either.  The
 * difference is a capability naming the BUFFER, which is the design cap_server
 * still owes this issue.
 */
routine device_dma_map_foreign(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	in	paddr		: vm_address_t;
	out	dma_addr	: vm_address_t
	);

/*
 * ── Claim a device, by presenting a capability for its KIND (#432) ───
 *
 * 🔴 THIS IS WHERE "MAY I DRIVE THIS DEVICE" IS ASKED, and it is asked ONCE.
 * Holding the master device port used to be the whole answer: any task with it
 * could name any bus/device/function and have memory mapped into that device's
 * domain -- and a page inside somebody else's device's domain is a page that
 * DEVICE can reach, which is the one direction nothing else in this system
 * checks.
 *
 * 🔑 THE TOKEN NAMES A CLASS, NOT A DEVICE, and the split is deliberate.  A
 * bus/device/function is a property of the BOARD -- this tree's AHCI is
 * 00:04.0 with one command line and 00:1f.2 with another -- so a policy naming
 * one would have to be rewritten per machine.  The token says what KIND of
 * device this task may drive, out of its manifest; the CLAIM says it got this
 * one first.  Neither is a policy alone:
 *
 *	the manifest   what kind of hardware this driver is for
 *	the claim      which instance of it this task got
 *
 * The kernel reads the class out of the device's own configuration space and
 * requires the token to name it, so the two halves are checked against
 * different sources: one is a signed statement about the task, the other is
 * the hardware answering for itself.
 *
 * 🔴 AND WHAT IS CHECKED AFTERWARDS IS THE CLAIM, ON THE BUFFER CALLS ONLY.
 * Five of them ask -- dma_alloc, dma_free, dma_alloc_sg, dma_identity and
 * dma_map_foreign -- and every one is about obtaining or releasing memory.
 * Verifying a token instead would mean an HMAC-SHA256 under a lock the whole
 * machine shares, on a path that runs once per buffer; the claim is a pointer
 * comparison, and the question it answers cannot change in between.
 *
 * 🔑 A TRANSFER IS CHECKED BY NEITHER, BECAUSE A TRANSFER DOES NOT COME HERE.
 * A userspace driver reads a disk by writing an address into the device's own
 * descriptor and poking a register: no system call, nothing for the kernel to
 * see, and therefore no place to put a check.  That is not a gap in this
 * design -- it IS the design, and it is the entire reason #432 exists.  The
 * only thing that can police that transfer is the hardware, which is what the
 * domain the claim gives access to is for.
 *
 * ⚠️ On a machine with no manifest shipped, cap_server issues freely and this
 * check passes: enforcement is always on, and how strict it is depends on the
 * policy file.  That is the honest arrangement -- the mechanism does not
 * pretend the policy exists, and the policy does not need the mechanism to be
 * turned on twice.
 */
routine device_claim(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	in	token		: cap_token_t
	);

routine device_dma_owned(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	out	by_other	: natural_t
	);

routine device_dma_faults(
		master_port	: mach_port_t;
	in	bdf		: natural_t;
	out	confined	: natural_t;
	out	count		: natural_t;
	out	address		: vm_address_t
	);
