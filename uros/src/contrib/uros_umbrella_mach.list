/*
 * Extra dynamic-list for the umbrella libc.so (#375).
 *
 * The umbrella folds in the Uros PIC backend (posix-uros/vfs/mach/netname/
 * cap) but links it with -Wl,--exclude-libs=ALL, so those symbols are LOCAL
 * and unreachable by dynamic tools.  A dynamically-linked tool needs a small
 * Mach surface of the umbrella's own, so it can use the umbrella's single,
 * already initialised Mach runtime instead of statically duplicating libmach
 * (which leaves the copy's mach_init un-run and crashes on the first trap).
 *
 * ⚠️ THIS LIST DOES NOT EXPORT THEM (#917, measured).  What exports a symbol
 * is its object reaching the link LOOSE, out of --exclude-libs' reach:
 * libmach_export_objs in lib/libmach/CMakeLists.txt.  With mach_error and
 * mach_error_string in that library and not here, libc.so exported both; with
 * them here and not there, it exported neither, and a program that called
 * them did not link.  For a shared library GNU ld reads a dynamic list as the
 * globals whose references are not bound to the library's own definition, so
 * what this does to the three below is keep them preemptible.  It was written
 * when it was taken to be the export, as was "musl re-exports its own public
 * API the same way": musl's objects are loose in that link.
 *
 * Keep this minimal: entry points only.  Their internals (mach_msg, reply
 * port, task-self cache) stay local in the umbrella and resolve there.
 */
{
	mach_host_self;
	host_processors;
	processor_info;
};
