 * SPDX-License-Identifier: MIT
 *
 * char_server.defs — MIG control plane for char_server.
 *
 * Mirror of gpu_server.defs (subsystem 4000) for character devices.
 * Cap-gated on every entry per design.  The MIG surface ships in
 * #205 with stubs; #206 (ps2.so) wires up kbd_subscribe; #207
 * (uart.so) wires up the tty_* family.
 */

subsystem char_server 4100;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

serverprefix char_;
userprefix   char_;

type chr_u32_t   = unsigned    ctype: chr_u32_t;
type chr_u64_t   = unsigned64  ctype: chr_u64_t;
type chr_token_t = array[*:256]  of char;
type chr_buf_t   = array[*:4096] of char;

import <mach/char_server_types.h>;

/* =================================================================
 * Device discovery / open
 * ================================================================= */

/*
 * query_devices — return all char_device records as an OOL array of
 * `struct char_device_info` (char/char_types.h).
 */
routine query_devices(
		char_port	: mach_port_t;
	out	devices		: pointer_t, Dealloc;
	out	n_devices	: chr_u32_t);

/*
 * device_open — handshake.  Cap-checked against device_class:
 *   keyboard → CHAR_CAP_KBD_READ
 *   tty      → CHAR_CAP_TTY_RW
 * Returns KERN_SUCCESS if allowed.  Today a no-op (no per-client
 * state held); future #202-style handle table hooks here.
 */
routine device_open(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t);

/* =================================================================
 * Keyboard plane (#206 wires this up)
 * ================================================================= */

/*
 * kbd_subscribe — register a notify port that receives keyboard
 * events (one Mach msg per char_kbd_event_t).  The module retains
 * the SEND right; subscriber tear-down by either revoking the cap
 * (#197 cap_revoke_notify) or letting the port go dead (handled
 * via no-senders notification once #202 lands).
 */
routine kbd_subscribe(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	notify_port	: mach_port_t);

/* =================================================================
 * TTY plane (#207 wires this up)
 * ================================================================= */

/*
 * tty_read — block until at least one byte is available, return up
 * to `max` bytes.  `buf` length is the actual number returned.
 *
 * Job-control (#275.2): `caller_pid` is the POSIX pid of the calling
 * process.  If the caller's session owns this tty as ctty AND the
 * caller's pgrp is not the foreground pgrp, char_server sends SIGTTIN
 * to the calling pgrp via proc_killpg and returns CHR_TTY_BACKGROUND
 * with buf empty.  caller_pid == 0 means "skip job-control check"
 * (debug / privileged readers).
 */
routine tty_read(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	caller_pid	: int;
	in	max		: chr_u32_t;
	out	buf		: chr_buf_t;
	out	result		: int);

/*
 * tty_write — fire-and-forget byte stream out to the UART.
 * simpleroutine: producer never blocks on serial speed (the module
 * absorbs the wait or drops on flow-control timeout).
 */
simpleroutine tty_write(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	buf		: chr_buf_t);

/*
 * tty_set_attr — line discipline params.  Cap-gated on
 * CHAR_CAP_TTY_CONFIG (admin only — changing baud under another
 * client mid-stream would corrupt their bytes).
 */
routine tty_set_attr(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	baud		: chr_u32_t;
	in	data_bits	: chr_u32_t;
	in	parity		: chr_u32_t;
	in	stop_bits	: chr_u32_t);

/*
 * tty_subscribe — register a notify port for "data available"
 * wake-ups.  tty_read is non-blocking (returns 0 bytes on empty),
 * so clients that want to wait for input subscribe and then read
 * after each notification.  The module sends a header-only Mach msg
 * (msgh_id = CHAR_TTY_NOTIFY_ID) per RX-IRQ batch.
 */
routine tty_subscribe(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	notify_port	: mach_port_t);

/*
 * tty_acquire_ctty — the session leader claims this tty as the
 * controlling terminal for its session (#247 driver side, #275.1).
 * char_server forwards to proc_set_ctty(sid, tty_port) on the
 * proc_server, where tty_port is a fresh send right to char_server's
 * service port (proc_server keeps it for the lifetime of the ctty —
 * future signal delivery / TIOCNOTTY routes through it).
 *
 * Cap-gated on CHAR_CAP_TTY_RW (no separate CTTY op for v0.1 — the
 * read/write cap already implies the right to bind the session).
 * `result` carries the proc_server PROC_OK / PROC_ERR_* code so the
 * libposix-uros wrapper can map it to POSIX errno (EPERM if the
 * session already owns a controlling tty, etc.).
 */
routine tty_acquire_ctty(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	sid		: int;
	out	result		: int);

/* =================================================================
 * Mouse plane (#215 — ps2_mouse.so)
 * ================================================================= */

/*
 * mouse_subscribe — register a notify port that receives mouse
 * events (one Mach msg per char_mouse_event_t).  Same shape as
 * kbd_subscribe: the module retains the SEND right; the subscriber
 * tears down by revoking the cap or letting the port go dead.
 */
routine mouse_subscribe(
		char_port	: mach_port_t;
	in	cap		: chr_token_t;
	in	dev_id		: chr_u32_t;
	in	notify_port	: mach_port_t);
