/*
 * exec.defs — MIG interface for exec_server (#228 v0.1.0).
 *
 * Subsystem 3100.  Single routine in v0.1.0: synchronously load an
 * ELF binary from a libvfs-resolvable path into a task the caller made,
 * and create the initial thread to run it (#926).
 *
 * Naming convention (uses the migcom serverstripprefix extension
 * introduced in #227):
 *   - User stub (libposix / ipc_bench):  exec_load
 *   - Server impl (exec_server):         exec_S_load
 */

subsystem
#if	KERNEL_SERVER
	  KernelServer
#endif	/* KERNEL_SERVER */
		       exec 3100;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

serverprefix		exec_S_;
serverstripprefix	exec_;

import "exec_types.h";

type exec_path_t = c_string[*:1024];
type exec_blob_t = pointer_t;

/*
 * exec_load — load a static ELF binary into a fresh task the caller made.
 *
 *   task        — the task to load into: empty, made by the caller with
 *                 task_create(mach_task_self(), ..., FALSE, &task), so
 *                 the child is the caller's and inherits from it.
 *                 exec_server holds it for the length of the call and
 *                 gives its right back before it answers (#926).  On a
 *                 failure the task may be half loaded: the caller
 *                 terminates it.
 *   parent_caps — the caller's per-task cap port (its TASK_CAP_PORT,
 *                 libmach's mach_cap_port), or MACH_PORT_NULL (#743).
 *                 The new program's port is derived from it: what the
 *                 program's .uros_manifest asks for, cut to what the
 *                 caller's manifest may hand on.  With none, the
 *                 program gets no port and is refused every
 *                 capability (#511).
 *   path        — absolute path to the binary, resolved through
 *                 libvfs by exec_server.
 *   argv_blob   — serialised argv (see exec_blob_t in exec_types.h).
 *   envp_blob   — serialised envp.
 *
 *   new_thread  — initial thread port, MOVED to the caller: exec_server
 *                 keeps no right to it (#926).  Returned SUSPENDED
 *                 (#262 step 3): the caller hands over any inherited fds
 *                 into the new task, then thread_resume's it so the new
 *                 image starts with a populated fd table.
 *   result_code — EXEC_OK on success, EXEC_ERR_* otherwise.
 *
 * 🔴 #926: exec_server used to be handed the CALLER's task, to be the
 * parent of one it made, and kept it; and it answered the new task and its
 * thread as plain mach_port_t, COPY_SEND, so it kept those too.  A send right
 * to a task port is the task.
 */
routine exec_load(
		exec_port	: mach_port_t;
	in	task		: task_t;
	in	parent_caps	: mach_port_t;
	in	path		: exec_path_t;
	in	argv_blob	: exec_blob_t;
	in	envp_blob	: exec_blob_t;
	out	new_thread	: mach_port_move_send_t;
	out	result_code	: int);
