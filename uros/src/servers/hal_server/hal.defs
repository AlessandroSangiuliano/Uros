/*
 * Copyright (c) 2026 Alessandro Sangiuliano (Slex) <alex22_7@hotmail.com>
 * SPDX-License-Identifier: MIT
 *
 * MIG interface of the HAL server.  Three RPCs:
 *
 *   hal_list_devices     — return the full device registry (OOL)
 *   hal_get_device_info  — return one device entry by PCI BDF
 *   hal_register_driver  — subscribe a driver server to a class mask;
 *                          subsequent hotplug adds of matching devices
 *                          will be notified on driver_port
 *
 * The out buffer of hal_list_devices is an array of struct
 * hal_device_info laid out back-to-back (see hal_server.h).
 */

subsystem hal 2970;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

serverprefix hal_;
userprefix  hal_;

routine list_devices(
		hal_port	: mach_port_t;
	out	devices		: pointer_t, Dealloc;
	out	n_devices	: unsigned);

routine get_device_info(
		hal_port	: mach_port_t;
	in	bus		: unsigned;
	in	slot		: unsigned;
	in	func		: unsigned;
	out	vendor_device	: unsigned;
	out	class_rev	: unsigned;
	out	irq		: unsigned);

routine register_driver(
		hal_port	: mach_port_t;
	in	class_mask	: unsigned;
	in	class_match	: unsigned;
	in	driver_port	: mach_port_t);

/*
 * #173 — re-run the discovery pass against every loaded back-end.
 * Devices already in the registry (matched by BDF) are refreshed but
 * generate no notification; only newly-seen devices propagate via
 * hal_device_added.  Appended at the end so the existing msg ids
 * stay stable.
 */
routine rescan(
		hal_port	: mach_port_t);

/*
 * #427 — the device's regions, decoded.
 *
 * The out buffer is an array of struct pci_bar_region (see libpci/pci_bar.h)
 * laid out back-to-back, the same untyped arrangement list_devices uses.
 *
 * 🔑 Its own routine and not four more `out' parameters on get_device_info,
 * because how many regions a device has is not fixed: a 64-bit memory BAR
 * takes two of the six slots, so the count is a result and not a constant.
 * An interface that returned six of anything would be the same mistake the
 * record had, moved to the wire.
 *
 * ⚠️ This is what closes the gap that made every driver read configuration
 * space for itself.  get_device_info hands back the vendor, the class, the
 * IRQ and the status -- everything except the one field needed to map the
 * device -- so a driver that wanted its BAR had no way to ask, and went to
 * the bus.  Four drivers doing that is not four bad decisions; it is an
 * interface that left no other move.
 *
 * Appended at the end so the existing msg ids stay stable.
 */
routine get_device_bars(
		hal_port	: mach_port_t;
	in	bus		: unsigned;
	in	slot		: unsigned;
	in	func		: unsigned;
	out	bars		: pointer_t, Dealloc;
	out	n_bars		: unsigned);

/*
 * #513 — a driver says what happened when it probed a device.
 *
 * 🔴 THE OUTCOME IS THE ONE FACT NOBODY ELSE HAS.  The kernel knows who HOLDS a
 * device -- device_claim() is a transaction with it -- and the bus knows what is
 * plugged in.  Whether a driver brought a controller up is a fact about the
 * driver, and until this routine existed there was no way for it to reach the
 * registry: hal_register_driver subscribes to a class, hal_device_added is a
 * simpleroutine with no reply, and a driver probed and was never asked again.
 *
 * ⚠️ `driver_port' is the port the driver registered with, and the HAL matches
 * it against its subscription table rather than trusting the report's contents.
 * A report from a port the HAL never handed a device to is refused.
 *
 * 🔑 AND A SUCCESS IS CHECKED AGAINST THE KERNEL.  Recording BOUND on the
 * driver's word would make this registry a second claim table, free to disagree
 * with the one that actually gates DMA -- which is the failure #427 removed a
 * field for, moved one server along.  So the HAL asks whether the device is
 * really held before it believes the report.
 *
 * Appended at the end so the existing msg ids stay stable.
 */
routine report_probe(
		hal_port	: mach_port_t;
	in	bus		: unsigned;
	in	slot		: unsigned;
	in	func		: unsigned;
	in	driver_port	: mach_port_t;
	in	outcome		: unsigned);

/*
 * #513 — which devices have drivers, which is what a HAL is for.
 *
 * ⚠️ Its own routine rather than another out-parameter on get_device_info,
 * because this one changes while a machine runs and the rest of that record
 * does not.  A reader that wanted the current state would have had to re-read
 * the vendor and the class to get it.
 */
routine get_device_state(
		hal_port	: mach_port_t;
	in	bus		: unsigned;
	in	slot		: unsigned;
	in	func		: unsigned;
	out	state		: unsigned);
