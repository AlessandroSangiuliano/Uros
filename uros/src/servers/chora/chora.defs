/*
 * chora.defs -- a chora's control port (#964).
 *
 * Once its module drives the device, a chora checks a port in with the name
 * server under its own name, MODULE@BB:DD.F -- the device's -- and answers on
 * it.  A consumer finds the driver of a device by that name; when the HAL
 * starts a dead chora again, the name is the new chora's, and the consumer
 * asks it as it asked the old one.  chora_status() is the one routine for
 * now: what the chora drives.  The control plane the queue capability brings
 * (#965) is to be built on this port.
 *
 * Routines are appended at the end: MIG numbers them by position.
 */

subsystem chora 9650;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

userprefix	chora_;
serverprefix	chora_S_;

import <mach/module_pool.h>;

type chora_module_name_t = array[*:64] of char	/* MODULE_NAME_MAX */
	ctype: module_name_t;

/*
 * The module that drives the device, its name with no ".so", and the
 * device's address, bus << 8 | slot << 3 | func.
 */
routine status(
		chora_port	: mach_port_t;
	out	module		: chora_module_name_t, CountInOut;
	out	bdf		: unsigned);
