/*
 * Subsystem 2960: FLIPC v2 endpoint handshake.
 *
 * The server registers a receive port via netname_check_in.
 * Clients discover it via netname_look_up and then call
 * flipc2_endpoint_connect to establish a pair of SPSC channels.
 *
 * The server creates two channels (fwd: server→client, rev:
 * client→server) and answers a memory entry for each, which the
 * client maps into its own address space (#911).
 */

subsystem flipc2_endpoint 2960;

#include <mach/std_types.defs>

serverprefix ds_;

import "flipc2_endpoint_types.h";

/*
 * Connect to an endpoint: the server creates a bidirectional SPSC
 * channel pair and answers a memory entry for each channel, with the
 * protections the client's role allows on each of its sections; the
 * client maps them itself.
 *
 * 🔑 The client sends a token, not its task port (#911).  The token is a
 * port the client made for this connection and holds the receive right
 * of: the server asks for a dead-name notification on it, and the
 * connection ends when it dies -- with the client, or when the client
 * destroys it, which is how a client disconnects.  Before #911 the
 * client sent its task port and the server vm_remap()ped the channels
 * into it, so every endpoint held, for as long as a connection lasted,
 * the right to read and write all of the connected client's memory.
 * MAKE_SEND is the point of the type: the kernel makes the right from a
 * receive right the sender holds, and no task holds the receive right
 * of a task port, so no task port can travel here, even by mistake.
 *
 * client_token:	the client's token, a send right made in transit
 * channel_size:	requested channel size (0 = server default)
 * ring_entries:	requested ring entries (0 = server default)
 * fwd_entry/rev_entry:	memory entries for the two channels
 * size_out/entries_out: actual parameters used by server
 *
 * There is no disconnect routine: a connection ends with its token.
 */
routine flipc2_endpoint_connect_rpc(
		server_port	: mach_port_t;
	in	client_token	: mach_port_make_send_t;
	in	channel_size	: unsigned32;
	in	ring_entries	: unsigned32;
	out	fwd_entry	: mach_port_move_send_t;
	out	rev_entry	: mach_port_move_send_t;
	out	size_out	: unsigned32;
	out	entries_out	: unsigned32
	);
